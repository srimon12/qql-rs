{
  "name": "QQL",
  "scopeName": "source.qql",
  "fileTypes": ["qql"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.qql",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.qql",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.qql", "match": "''" },
            { "name": "constant.character.escape.qql", "match": "\\\\['\"\\\\ntr]" }
          ]
        },
        {
          "name": "string.quoted.double.qql",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.qql", "match": "\\\\['\"\\\\ntr]" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.qql",
          "match": "-?\\d+(\\.\\d+([eE][+-]?\\d+)?|([eE][+-]?\\d+))"
        },
        {
          "name": "constant.numeric.integer.qql",
          "match": "-?\\d+"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.qql",
          "match": "\\b(?i)(true|false)\\b"
        },
        {
          "name": "constant.language.null.qql",
          "match": "\\b(?i)(null)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qql",
          "match": "\\b(?i)(QUERY|UPSERT|DELETE|UPDATE|SET|COUNT|SCROLL|CLEAR|SHOW|CREATE|ALTER|DROP|EMBED)\\b"
        },
        {
          "name": "keyword.other.qql",
          "match": "\\b(?i)(INTO|FROM|WHERE|LIMIT|OFFSET|USING|WITH|AS|ON|FOR|BY|AFTER|VALUES|IN|BETWEEN|IS|NOT|AND|OR|EMPTY|FIELD)\\b"
        },
        {
          "name": "keyword.query.qql",
          "match": "\\b(?i)(NEAREST|HYBRID|DENSE|SPARSE|RECOMMEND|CONTEXT|DISCOVER|ORDER|ASC|DESC|SAMPLE|RANDOM|FUSION|RRF|DBSF|FORMULA|MMR|DIVERSITY|CANDIDATES|RERANK|RELEVANCE|FEEDBACK|POINTS|TEXT|VECTOR|PAYLOAD|PREFETCH|TARGET|PAIRS|POSITIVE|NEGATIVE|STRATEGY|GROUP|SIZE|LOOKUP|SCORE|THRESHOLD|SHARD|KEY|KEYS|DEFAULTS|STAR)\\b"
        },
        {
          "name": "keyword.ddl.qql",
          "match": "\\b(?i)(COLLECTION|COLLECTIONS|INDEX|HNSW|OPTIMIZERS|PARAMS|QUANTIZATION|SCALAR|BINARY|PRODUCT|TURBO|BITS|QUANTILE|ALWAYS|RAM|DISABLED|MULTIVECTOR|COSINE|DOT|EUCLID|MANHATTAN|EXACT|ACORN|INDEXED_ONLY|MODEL|TYPE)\\b"
        },
        {
          "name": "keyword.filter.qql",
          "match": "\\b(?i)(MATCH|ANY|PHRASE|NESTED|HAS_VECTOR|VALUES_COUNT|GEO_BBOX|GEO_RADIUS|GEO_POLYGON|ID)\\b"
        },
        {
          "name": "keyword.formula.qql",
          "match": "\\b(?i)(CASE|WHEN|THEN|ELSE|END|ABS|SQRT|LOG|LN|EXP|POW|GEO_DISTANCE|EXP_DECAY|GAUSS_DECAY|LIN_DECAY|datetime|datetime_key|BOOST)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.qql",
          "match": "!=|<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.qql",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.qql",
          "match": "[\\+\\-\\*\\/]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.qql", "match": ";" },
        { "name": "punctuation.separator.qql", "match": "," },
        { "name": "punctuation.definition.bracket.qql", "match": "[\\{\\}\\[\\]]" },
        { "name": "punctuation.definition.paren.qql", "match": "[\\(\\)]" },
        { "name": "punctuation.separator.key-value.qql", "match": ":" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.qql",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(\\[\\]\\.?)*"
        },
        {
          "name": "entity.name.qql",
          "match": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*|\\[\\]\\.?)*"
        }
      ]
    }
  }
}
