{
  "Nearest search": {
    "prefix": ["qnearest", "qsearch"],
    "body": [
      "QUERY TEXT '${1:search term}'",
      "  FROM ${2:collection} USING ${3:dense}",
      "  LIMIT ${4:10};"
    ],
    "description": "Nearest-neighbor semantic search"
  },
  "Hybrid RRF": {
    "prefix": ["qhybrid", "qrrf"],
    "body": [
      "QUERY HYBRID TEXT '${1:search term}'",
      "  DENSE ${2:dense} SPARSE ${3:sparse}",
      "  FUSION RRF",
      "  FROM ${4:collection}",
      "  LIMIT ${5:10};"
    ],
    "description": "Hybrid dense+sparse RRF search"
  },
  "CTE + Fusion": {
    "prefix": ["qcte", "qfusion"],
    "body": [
      "WITH",
      "  ${1:dense} AS (QUERY TEXT '${2:search}' USING ${3:dense} LIMIT 100),",
      "  ${4:sparse} AS (QUERY TEXT '${2:search}' USING ${5:sparse} LIMIT 100)",
      "QUERY FUSION RRF",
      "  FROM ${6:collection}",
      "  PREFETCH (${1:dense}, ${4:sparse})",
      "  LIMIT ${7:10};"
    ],
    "description": "Multi-stage CTE + RRF fusion"
  },
  "Create collection": {
    "prefix": ["qcreate", "qcollection"],
    "body": [
      "CREATE COLLECTION ${1:collection} (",
      "  ${2:dense} VECTOR(${3:384}, ${4|COSINE,DOT,EUCLID,MANHATTAN|})",
      ") WITH HNSW (m = ${5:16}, ef_construct = ${6:100});"
    ],
    "description": "Create a dense collection"
  },
  "Upsert with embed": {
    "prefix": ["qupsert"],
    "body": [
      "UPSERT INTO ${1:collection} VALUES",
      "  {id: ${2:1}, text: '${3:document}'}",
      "  USING DENSE MODEL '${4:all-MiniLM-L6-v2}';"
    ],
    "description": "Upsert points with auto-embedding"
  },
  "Cross rerank": {
    "prefix": ["qcross", "qrerank"],
    "body": [
      "WITH ${1:candidates} AS (QUERY TEXT '${2:search}' USING ${3:dense} LIMIT 100)",
      "QUERY CROSS RERANK TEXT '${2:search}' MODEL '${4:cross-encoder}' ON FIELD ${5:body}",
      "  FROM ${6:collection}",
      "  PREFETCH (${1:candidates})",
      "  LIMIT ${7:10};"
    ],
    "description": "Cross-encoder pair rerank"
  },
  "Count exact": {
    "prefix": ["qcount"],
    "body": [
      "COUNT FROM ${1:collection} WHERE ${2:active} = true WITH (exact = true);"
    ],
    "description": "Exact point count"
  },
  "Recommend": {
    "prefix": ["qrecommend"],
    "body": [
      "QUERY RECOMMEND POSITIVE (${1:1}, ${2:2}) NEGATIVE (${3:3})",
      "  STRATEGY ${4|average_vector,best_score,sum_scores|}",
      "  FROM ${5:collection}",
      "  LIMIT ${6:10};"
    ],
    "description": "Recommendation search"
  },
  "Show quotas": {
    "prefix": ["qquota", "qshowquota"],
    "body": [
      "SHOW QUOTAS;"
    ],
    "description": "Show cluster resource quotas"
  },
  "Set quota": {
    "prefix": ["qsetquota"],
    "body": [
      "SET QUOTA (",
      "  enabled = ${1|true,false|},",
      "  max_resident_memory_percent = ${2:80},",
      "  max_disk_usage_percent = ${3:90},",
      "  release_margin_percent = ${4:5}",
      ") WAIT ${5|true,false|};"
    ],
    "description": "Replace cluster quota config (full PUT)"
  },
  "Match PREFIX filter": {
    "prefix": ["qprefix", "qmatchprefix"],
    "body": [
      "QUERY TEXT '${1:search}' FROM ${2:collection}",
      "  WHERE ${3:title} MATCH PREFIX '${4:prefix}'",
      "  LIMIT ${5:10};"
    ],
    "description": "Keyword/text MATCH PREFIX filter"
  },
  "SLICE filter": {
    "prefix": ["qslice"],
    "body": [
      "QUERY TEXT '${1:search}' FROM ${2:collection}",
      "  WHERE SLICE (${3:4}, ${4:0})",
      "  LIMIT ${5:10};"
    ],
    "description": "Deterministic SLICE sampling filter"
  },
  "Create collection with memory": {
    "prefix": ["qcreatemem", "qmemory"],
    "body": [
      "CREATE COLLECTION ${1:collection} (",
      "  ${2:dense} VECTOR(${3:384}, ${4|COSINE,DOT,EUCLID,MANHATTAN|})",
      "    WITH VECTOR (memory = '${5|cached,cold,pinned|}', datatype = '${6|float32,float16,uint8,turbo4|}')",
      ") WITH HNSW (memory = '${7|cold,cached,pinned|}')",
      "  WITH PARAMS (payload_memory = '${8|cold,cached|}');"
    ],
    "description": "Create collection with memory placement + datatype"
  },
  "Keyword index with prefix": {
    "prefix": ["qindexprefix"],
    "body": [
      "CREATE INDEX ON COLLECTION ${1:collection} FOR ${2:field} TYPE keyword",
      "  WITH (prefix = true, is_tenant = ${3|true,false|});"
    ],
    "description": "Keyword index with prefix matching enabled"
  },
  "IDF search param": {
    "prefix": ["qidf"],
    "body": [
      "QUERY TEXT '${1:search}' FROM ${2:collection}",
      "  PARAMS (idf = '${3|global|}')",
      "  LIMIT ${4:10};"
    ],
    "description": "Per-query sparse IDF corpus (global)"
  }
}
