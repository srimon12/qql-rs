---
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import config from "virtual:starlight/user-config";
import type { DocsHeaderConfig } from "../types";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	docsConfig: DocsHeaderConfig;
}

const { docsConfig } = Astro.props;

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== "@astrojs/starlight/components/Search.astro";

const currentPath = Astro.url.pathname;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  
  <nav class="sl-hidden lg:sl-flex center-nav">
    {docsConfig.navItems.map((item) => {
      const isExternal = item.external || item.href.startsWith("http");
      const pathname = isExternal ? "" : new URL(item.href, "http://localhost").pathname;
      const isActive = !isExternal && currentPath.startsWith(pathname) && item.name === "Docs";
      return (
        <a 
          href={item.href} 
          class={`nav-link ${isActive ? 'active' : ''}`}
          aria-current={isActive ? "page" : undefined}
          {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {item.name}
        </a>
      );
    })}
  </nav>

  <div class="sl-flex print:hidden right-group">
    <div class="search-container">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="sl-hidden md:sl-flex social-icons">
      <SocialIcons />
    </div>
    <div class="sl-flex select-group">
      <div class="sl-hidden md:sl-flex">
        <ThemeToggle />
      </div>
      <div class="sl-hidden md:sl-flex">
        <LanguageSelect />
      </div>
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }
    .title-wrapper {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .right-group {
      gap: 1rem;
      align-items: center;
    }
    .social-icons {
      gap: 1rem;
      align-items: center;
    }
    .social-icons::after {
      content: '';
      height: 1.5rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
      opacity: 0.7;
      margin-left: 0.25rem;
    }

    @media (min-width: 50rem) {
      .header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-content: center;
      }
    }
  }

  .center-nav {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    margin: 0 0.25rem;
    border-radius: 9999px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover {
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }

  .nav-link.active {
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--sl-color-gray-5) 80%, transparent);
  }

  .select-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-icons :global(a) {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icons :global(a):hover {
    transform: scale(1.1) rotate(4deg);
    color: var(--sl-color-text-accent) !important;
  }

  .search-container :global(.search-input) {
    border-radius: 9999px !important;
    transition: all 0.2s;
  }

  .search-container :global(.search-input:focus) {
    box-shadow: 0 0 12px rgba(195, 88, 56, 0.2) !important;
  }

  /* Site title gradient styling */
  :global(.site-title) {
    font-weight: 800 !important;
    letter-spacing: -0.02em !important;
    background: linear-gradient(135deg, var(--sl-color-white) 40%, var(--sl-color-accent-high) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: opacity 0.2s;
  }

  :global(.site-title:hover) {
    opacity: 0.9;
  }
</style>
