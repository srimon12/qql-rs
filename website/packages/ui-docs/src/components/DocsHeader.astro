---
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import config from "virtual:starlight/user-config";
import type { DocsHeaderConfig } from "../types";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	docsConfig: DocsHeaderConfig;
}

const { docsConfig } = Astro.props;

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== "@astrojs/starlight/components/Search.astro";

const currentPath = Astro.url.pathname;
const markSrc = `${import.meta.env.BASE_URL}logo.svg`.replace(/([^:]\/)\/+/g, "$1");
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="docs-brand" href="/" aria-label="QQL home">
      <span class="docs-brand__mark" aria-hidden="true">
        <img src={markSrc} alt="" width="32" height="32" />
      </span>
      <span class="docs-brand__name">QQL</span>
      <span class="docs-brand__chip">Docs</span>
    </a>
  </div>
  
  <nav class="sl-hidden lg:sl-flex center-nav">
    {docsConfig.navItems.map((item) => {
      const isExternal = item.external || item.href.startsWith("http");
      const pathname = isExternal ? "" : new URL(item.href, "http://localhost").pathname;
      const isActive = !isExternal && currentPath.startsWith(pathname) && item.name === "Docs";
      return (
        <a 
          href={item.href} 
          class={`nav-link ${isActive ? 'active' : ''}`}
          aria-current={isActive ? "page" : undefined}
          {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          {item.name}
        </a>
      );
    })}
  </nav>

  <div class="sl-flex print:hidden right-group">
    <div class="search-container">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="sl-hidden md:sl-flex social-icons">
      <SocialIcons />
    </div>
    <div class="sl-flex select-group">
      <div class="sl-hidden md:sl-flex">
        <ThemeToggle />
      </div>
      <div class="sl-hidden md:sl-flex">
        <LanguageSelect />
      </div>
    </div>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }
    .title-wrapper {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }
    .right-group {
      gap: 1rem;
      align-items: center;
    }
    .social-icons {
      gap: 1rem;
      align-items: center;
    }
    .social-icons::after {
      content: '';
      height: 1.5rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
      opacity: 0.7;
      margin-left: 0.25rem;
    }

    @media (min-width: 50rem) {
      .header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-content: center;
      }
    }
  }

  /* Brand block: matches the landing/playground site header. */
  .docs-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }

  .docs-brand__mark {
    width: 2rem;
    height: 2rem;
    display: block;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 0.44rem;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .docs-brand__mark img,
  .docs-brand__mark svg {
    display: block;
    width: 2rem;
    height: 2rem;
  }

  .docs-brand__name {
    font-family: var(--sl-font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  .docs-brand__chip {
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
    font-family: var(--sl-font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .docs-brand__chip {
      display: none;
    }
  }

  .center-nav {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    margin: 0 0.25rem;
    border-radius: 0.5rem;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }

  .nav-link.active {
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--sl-color-gray-5) 80%, transparent);
  }

  .select-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-icons :global(a) {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-icons :global(a):hover {
    transform: scale(1.1) rotate(4deg);
    color: var(--sl-color-text-accent) !important;
  }

  .search-container :global(.search-input) {
    border-radius: 9999px !important;
    transition: all 0.2s;
  }

  .search-container :global(.search-input:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
    box-shadow: none !important;
  }
</style>
