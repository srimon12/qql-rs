---
import { Code } from "@astrojs/starlight/components";

interface Props {
  title?: string;
}

const { title = "QQL" } = Astro.props;
const html = await Astro.slots.render("default");
const code = html
  .replace(/<br\s*\/?>/gi, "\n")
  .replace(/<\/p>/gi, "\n")
  .replace(/<\/div>/gi, "\n")
  .replace(/<[^>]*>/g, "")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&amp;/g, "&")
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .trim();
const params = new URLSearchParams({
  q: code,
  ref: Astro.url.pathname,
});
const playgroundUrl = `/playground/?${params}`;
---

<div class="qql-example premium-card">
  <div class="qql-example__caption">
    <span class="qql-example__language">QQL</span>
    <span>{title}</span>
    <span class="qql-example__verified">WASM verified</span>
    <a href={playgroundUrl} class="qql-example__try">
      Try in playground
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="qql-example__code">
    <Code code={code} lang="sql" frame="none" />
  </div>
</div>
