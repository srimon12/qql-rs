---
import { Code } from "@astrojs/starlight/components";

interface Props {
  title?: string;
}

const { title = "QQL" } = Astro.props;
const html = await Astro.slots.render("default");
const fencedCode = html.match(/<pre[^>]*>\s*<code[^>]*>([\s\S]*?)<\/code>\s*<\/pre>/i)?.[1];
if (!fencedCode) {
  throw new Error("qqlExample requires a fenced SQL code block.");
}
const code = fencedCode
  .replace(/<br\s*\/?>/gi, "\n")
  .replace(
    /<\/div>\s*<\/div>\s*<div[^>]*class=["'][^"']*ec-line[^"']*["'][^>]*>\s*<div[^>]*>/gi,
    "\n",
  )
  .replace(/<[^>]*>/g, "")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&amp;/g, "&")
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .replace(/\n{3,}/g, "\n\n")
  .trim();
const params = new URLSearchParams({
  q: code,
  ref: Astro.url.pathname,
});
const playgroundUrl = `/playground/?${params}`;
---

<div class="qql-example premium-card">
  <div class="qql-example__caption">
    <span class="qql-example__language">QQL</span>
    <span>{title}</span>
    <a href={playgroundUrl} class="qql-example__try">
      Try in playground
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="qql-example__code">
    <Code code={code} lang="qql" frame="none" />
  </div>
</div>
