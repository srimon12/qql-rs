---
import { Code } from "@astrojs/starlight/components";

interface Props {
  title?: string;
}

const { title = "QQL" } = Astro.props;
const html = await Astro.slots.render("default");
const code = html
  .replace(/<br\s*\/?>/gi, "\n")
  .replace(/<\/p>/gi, "\n")
  .replace(/<\/div>/gi, "\n")
  .replace(/<[^>]*>/g, "")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&amp;/g, "&")
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .trim();
---

<div class="qql-example premium-card">
  <div class="caption">
    <span class="language">QQL</span>
    <span>{title}</span>
    <span class="verified">WASM verified</span>
  </div>
  <div class="code">
    <Code code={code} lang="sql" frame="none" />
  </div>
</div>

<style>
  .qql-example {
    margin: 1.5rem 0;
    overflow: hidden;
  }

  .caption {
    align-items: center;
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    display: grid;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    gap: 0.75rem;
    grid-template-columns: auto 1fr auto;
    padding: 0.65rem 1rem;
  }

  .language {
    color: var(--sl-color-accent);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .verified {
    color: var(--sl-color-gray-3);
  }

  .code :global(.expressive-code),
  .code :global(.frame),
  .code :global(pre) {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    margin: 0 !important;
  }
</style>
