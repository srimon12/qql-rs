---
interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<div class="premium-card" style="display: flex; flex-direction: column; height: 100%; margin: 0; padding: 1.5rem;">
  {title && <h3 class="glass-title">{title}</h3>}
  <div class="glass-content" style="flex-grow: 1;">
    <slot />
  </div>
</div>

<style>
  .glass-title {
    font-family: "Instrument Serif", Georgia, serif !important;
    font-size: 1.5rem !important;
    font-weight: 400 !important;
    color: var(--sl-color-white) !important;
    margin-top: 0 !important;
    margin-bottom: 0.75rem !important;
    letter-spacing: -0.01em;
  }

  .glass-content {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }

  .glass-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
