---
import { Code } from "@astrojs/starlight/components";

interface Props {
	title?: string;
}

const { title = "Terminal" } = Astro.props;

const html = await Astro.slots.render("default");
const rawText = html
	.replace(/<br\s*\/?>/gi, "\n")
	.replace(/<\/p>/gi, "\n")
	.replace(/<\/div>/gi, "\n")
	.replace(/<[^>]*>/g, "")
	.replace(/&lt;/g, "<")
	.replace(/&gt;/g, ">")
	.replace(/&amp;/g, "&")
	.replace(/&quot;/g, '"')
	.replace(/&#39;/g, "'")
	.trim();
---

<div class="not-content code-flat terminal-wrap my-6 overflow-hidden rounded-[10px] border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)]">
  <div class="flex h-9 items-center gap-2.5 border-b border-[var(--sl-color-gray-5)] px-3.5">
    <span class="h-3 w-px bg-[var(--sl-color-accent)]" aria-hidden="true"></span>
    <span class="font-mono text-[0.75rem] text-[var(--sl-color-gray-3)]">{title}</span>
  </div>
  <div class="px-4">
    <Code code={rawText} lang="bash" frame="none" />
  </div>
</div>
