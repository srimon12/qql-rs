---
interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<div class="not-content flex h-full flex-col rounded-[10px] border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] p-6">
  {title && (
    <h3 class="mb-3 mt-0 text-[1.25rem] font-semibold leading-[1.3] tracking-[-0.01em] text-[var(--sl-color-white)]">
      {title}
    </h3>
  )}
  <div class="flex-grow text-sm leading-relaxed text-[var(--sl-color-gray-2)] [&>p:last-child]:mb-0">
    <slot />
  </div>
</div>
