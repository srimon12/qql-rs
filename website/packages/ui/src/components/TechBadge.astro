---
interface Props {
	name: string;
	/**
	 * Accepted for content compatibility; badges are intentionally monochrome
	 * (hairline + mono label) so the docs do not grow pastel pill noise.
	 */
	variant?: string;
	color?: string;
}

const { name } = Astro.props;
---

<span class="not-content inline-flex items-center whitespace-nowrap rounded-full border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-2 py-0.5 font-mono text-[0.65rem] font-medium leading-none text-[var(--sl-color-gray-2)]">{name}</span>
