---
import { APPS } from "../config/site";

interface Props {
  active?: "home" | "docs" | "playground";
}

const { active } = Astro.props;
const nav = [
  { key: "docs", label: "Docs", href: "/docs/" },
  { key: "playground", label: "Playground", href: "/playground/" },
  { key: "blog", label: "Blog", href: APPS.blog.url, external: true },
] as const;
---

<header class="site-header" data-site-header>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="QQL home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32">
          <path d="M7.25 7.5h4.05L16 21.15 20.7 7.5h4.05L17.35 25.25h-2.7L7.25 7.5Z"></path>
        </svg>
      </span>
      <span class="brand__name">QQL</span>
      <span class="brand__badge">Query language</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["site-nav__link", active === item.key && "is-active"]}
          aria-current={active === item.key ? "page" : undefined}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__controls">
      <a
        class="chrome-icon-btn"
        href={APPS.github.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="QQL on GitHub"
      >
        <svg class="chrome-icon-btn__fill" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"></path>
        </svg>
      </a>

      <button class="chrome-icon-btn theme-button" type="button" data-theme-toggle aria-label="Toggle color theme">
        <svg class="theme-button__sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="theme-button__moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <button
        class="chrome-icon-btn site-header__menu-btn"
        type="button"
        data-menu-toggle
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg class="icon-burger" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
    {nav.map((item) => (
      <a
        href={item.href}
        class:list={[active === item.key && "is-active"]}
        target={item.external ? "_blank" : undefined}
        rel={item.external ? "noopener noreferrer" : undefined}
      >
        {item.label}
        {item.external && <span>↗</span>}
      </a>
    ))}
    <a href={APPS.github.url} target="_blank" rel="noopener noreferrer">
      GitHub
      <span>↗</span>
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  // Hide on scroll down, reveal on scroll up (threshold avoids jitter).
  if (header) {
    let lastScrollY = window.scrollY;
    let ticking = false;

    const handleScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = Math.max(0, window.scrollY);
        const delta = y - lastScrollY;
        header.classList.toggle("is-scrolled", y > 10);
        if (y < 80) {
          header.classList.remove("is-hidden");
        } else if (delta > 6) {
          header.classList.add("is-hidden");
        } else if (delta < -6) {
          header.classList.remove("is-hidden");
        }
        lastScrollY = y;
        ticking = false;
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  // Theme toggle (shared across pages, syncs all theme storage keys).
  document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";
    button.addEventListener("click", () => {
      const next =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("theme", next);
      localStorage.setItem("starlight-theme", next);
      localStorage.setItem("veristamp-theme", next);
    });
  });

  // Mobile menu.
  const menuToggle = document.querySelector<HTMLElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener("click", () => {
      const open = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!open));
      mobileMenu.toggleAttribute("hidden", open);
    });
  }
</script>
