---
interface Preset {
  id: string;
  label: string;
  description: string;
  category: string;
  query: string;
  statements: number;
}

interface Props {
  presets: Preset[];
  categories: string[];
}

const { presets, categories } = Astro.props;
---

<dialog class="m-auto w-[min(calc(100%-2rem),68rem)] max-h-[90vh] overflow-hidden rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] p-0 text-[var(--sl-color-gray-1)] shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm" id="preset-dialog" aria-labelledby="preset-dialog-title" data-app-dialog>
  <div class="flex max-h-[90vh] flex-col">
    <header class="flex items-start justify-between gap-4 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] p-5">
      <div>
        <span class="block font-mono text-[0.6rem] font-semibold uppercase tracking-[0.12em] text-[var(--sl-color-accent)]">Executable corpus</span>
        <h2 id="preset-dialog-title" class="!m-0 !mt-1 !font-[var(--sl-font)] !text-xl !font-semibold text-[var(--sl-color-white)]">Choose a valid fixture</h2>
        <p class="mt-1 text-xs text-[var(--sl-color-gray-3)]">Every example is loaded directly from <code>language/v1/fixtures/valid</code>.</p>
      </div>
      <button class="grid size-8 place-items-center rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] text-lg text-[var(--sl-color-gray-2)] hover:text-[var(--sl-color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" type="button" data-close-dialog aria-label="Close examples">×</button>
    </header>

    <div class="grid gap-3 border-b border-[var(--sl-color-gray-5)] p-5 pb-3">
      <label>
        <span class="sr-only">Search examples</span>
        <input class="min-h-10 w-full rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)] placeholder:text-[var(--sl-color-gray-4)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" type="search" placeholder="Search fixture groups…" name="preset-search" data-preset-search />
      </label>
      <div class="flex gap-1.5 overflow-x-auto" role="group" aria-label="Filter examples">
        <button type="button" class="rounded-full border border-[var(--sl-color-gray-5)] bg-transparent px-2.5 py-1 font-mono text-[0.65rem] text-[var(--sl-color-gray-3)] hover:border-[var(--sl-color-gray-4)] hover:text-[var(--sl-color-gray-1)] aria-pressed:border-[var(--sl-color-accent)] aria-pressed:bg-[var(--sl-color-accent)] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" aria-pressed="true" data-preset-category="all">All</button>
        {categories.map((category) => (
          <button class="shrink-0 rounded-full border border-[var(--sl-color-gray-5)] bg-transparent px-2.5 py-1 font-mono text-[0.65rem] text-[var(--sl-color-gray-3)] hover:border-[var(--sl-color-gray-4)] hover:text-[var(--sl-color-gray-1)] aria-pressed:border-[var(--sl-color-accent)] aria-pressed:bg-[var(--sl-color-accent)] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" type="button" aria-pressed="false" data-preset-category={category}>{category}</button>
        ))}
      </div>
    </div>

    <p class="m-0 px-5 pt-3 font-mono text-[0.65rem] text-[var(--sl-color-gray-3)]" data-preset-results role="status" aria-live="polite">
      {presets.length} examples available
    </p>
    <div class="grid min-h-48 grid-cols-1 gap-3 overflow-y-auto p-5 pt-3 sm:grid-cols-2" data-preset-list aria-label="QQL fixture examples">
      {presets.map((preset) => (
        <button
          class="grid content-start gap-2 rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] p-4 text-left text-[var(--sl-color-gray-2)] transition hover:border-[var(--sl-color-accent)]/60 hover:bg-[var(--sl-color-bg)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]"
          type="button"
          data-preset
          data-preset-id={preset.id}
          data-preset-label={preset.label}
          data-preset-description={preset.description}
          data-preset-category-value={preset.category}
          data-preset-query={preset.query}
        >
          <span class="flex justify-between font-mono text-[0.58rem] uppercase tracking-wide text-[var(--sl-color-accent)]">
            <span>{preset.category}</span>
            <span>{preset.statements} {preset.statements === 1 ? "statement" : "statements"}</span>
          </span>
          <strong class="text-sm text-[var(--sl-color-gray-1)]">{preset.label}</strong>
          <span class="text-xs leading-5 text-[var(--sl-color-gray-3)]">{preset.description}</span>
        </button>
      ))}
    </div>
  </div>
</dialog>
