---
interface Preset {
	id: string;
	label: string;
	description: string;
	category: string;
	query: string;
	statements: number;
}

interface Props {
	presets: Preset[];
	categories: string[];
}

const { presets, categories } = Astro.props;
---

<dialog class="app-dialog app-dialog--wide" id="preset-dialog" aria-labelledby="preset-dialog-title" data-app-dialog>
  <div class="flex max-h-[90vh] flex-col">
    <header class="flex items-start justify-between gap-4 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-5 py-4">
      <div class="min-w-0">
        <p class="mono-label m-0">Executable corpus</p>
        <h2 id="preset-dialog-title" class="m-0 mt-1 text-lg font-semibold tracking-[-0.01em] text-[var(--sl-color-white)]">Choose a fixture</h2>
        <p class="m-0 mt-1 text-xs leading-5 text-[var(--sl-color-gray-3)]">
          Every example loads from <code class="font-mono text-[0.7rem] text-[var(--sl-color-gray-2)]">language/v1/fixtures/valid</code>.
        </p>
      </div>
      <button class="app-icon-btn" type="button" data-close-dialog aria-label="Close examples">×</button>
    </header>

    <div class="border-b border-[var(--sl-color-gray-5)] px-5 py-4" data-live-section>
      <p class="mono-label m-0">Live collections</p>
      <p class="m-0 mt-1 text-xs leading-5 text-[var(--sl-color-gray-3)]" data-live-hint>
        Reading collections from your Qdrant…
      </p>
      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2" data-live-presets aria-label="Live collection presets"></div>
    </div>

    <div class="grid gap-3 border-b border-[var(--sl-color-gray-5)] px-5 py-4">
      <label>
        <span class="sr-only">Search examples</span>
        <input class="app-input" type="search" placeholder="Search fixture groups…" name="preset-search" data-preset-search />
      </label>
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter examples">
        <button
          type="button"
          class="shrink-0 rounded-full border border-[var(--sl-color-gray-5)] px-2.5 py-1 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)] transition-colors hover:border-[var(--sl-color-gray-4)] hover:text-[var(--sl-color-gray-1)] aria-pressed:border-[var(--sl-color-accent)] aria-pressed:text-[var(--sl-color-white)]"
          aria-pressed="true"
          data-preset-category="all">All</button>
        {categories.map((category) => (
          <button
            class="shrink-0 rounded-full border border-[var(--sl-color-gray-5)] px-2.5 py-1 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)] transition-colors hover:border-[var(--sl-color-gray-4)] hover:text-[var(--sl-color-gray-1)] aria-pressed:border-[var(--sl-color-accent)] aria-pressed:text-[var(--sl-color-white)]"
            type="button"
            aria-pressed="false"
            data-preset-category={category}>{category}</button>
        ))}
      </div>
    </div>

    <p class="m-0 px-5 pt-3 font-mono text-[0.72rem] text-[var(--sl-color-gray-3)]" data-preset-results role="status" aria-live="polite">
      {presets.length} examples available
    </p>
    <div class="grid min-h-48 grid-cols-1 gap-2 overflow-y-auto px-5 py-4 sm:grid-cols-2 lg:grid-cols-3" data-preset-list aria-label="QQL fixture examples">
      {presets.map((preset) => (
        <button
          class="grid content-start gap-2 rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] p-3.5 text-left text-[var(--sl-color-gray-2)] transition-colors hover:border-[var(--sl-color-gray-4)] hover:bg-[var(--sl-color-bg)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]"
          type="button"
          data-preset
          data-preset-id={preset.id}
          data-preset-label={preset.label}
          data-preset-description={preset.description}
          data-preset-category-value={preset.category}
          data-preset-query={preset.query}
        >
          <span class="flex justify-between gap-2 font-mono text-[0.625rem] uppercase tracking-[0.08em] text-[var(--sl-color-gray-3)]">
            <span class="truncate">{preset.category}</span>
            <span class="shrink-0">{preset.statements} {preset.statements === 1 ? "stmt" : "stmts"}</span>
          </span>
          <strong class="text-[0.8125rem] font-semibold text-[var(--sl-color-white)]">{preset.label}</strong>
          <span class="line-clamp-2 text-xs leading-5 text-[var(--sl-color-gray-3)]">{preset.description}</span>
        </button>
      ))}
    </div>
  </div>
</dialog>
