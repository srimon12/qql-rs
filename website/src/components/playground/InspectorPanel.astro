---
const primary: Array<[string, string, string]> = [
	["response", "Result", "Live hits. Needs a reachable Qdrant."],
	["plan", "Plan", "Offline. Compiled plan, no backend needed."],
	["wire", "Wire", "Offline. REST payload, no backend needed."],
];
const secondary: Array<[string, string, string]> = [
	["ast", "AST", "Offline. Parsed tree, no backend needed."],
	["explain", "Explain", "Offline. Human readable plan, no backend needed."],
	["tokens", "Tokens", "Offline. Lexer output, no backend needed."],
	["metrics", "Metrics", "Offline. Local timings, no backend needed."],
];
const tabClass =
	"shrink-0 border-b-2 border-transparent bg-transparent px-2 py-2 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)] transition-colors hover:text-[var(--sl-color-gray-1)] aria-selected:border-[var(--sl-color-accent)] aria-selected:text-[var(--sl-color-white)] sm:px-2.5";
---

<section class="flex min-h-0 min-w-0 flex-col" aria-labelledby="inspector-title">
  <div class="flex min-h-11 shrink-0 items-center justify-between gap-2 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-3">
    <h2 id="inspector-title" class="flex min-w-0 items-center gap-2 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-[var(--sl-color-gray-3)]">
      <span class="h-3 w-px shrink-0 bg-[var(--sl-color-accent)]" aria-hidden="true"></span>
      <span class="truncate">Compiler</span>
    </h2>
    <div class="flex min-w-0 items-center gap-2">
      <code class="hidden min-w-0 truncate font-mono text-[0.6875rem] text-[var(--sl-color-accent-high)] sm:block" data-route-line></code>
      <label class="min-w-0" data-statement-wrap hidden>
        <span class="sr-only">Statement</span>
        <select class="app-select min-h-7 w-auto min-w-24 px-2 font-mono text-[0.72rem]" data-statement-select name="statement-select" aria-label="Inspect statement" disabled hidden>
          <option value="0">Statement 1</option>
        </select>
      </label>
    </div>
  </div>

  <div class="tabbar-fade relative flex shrink-0 gap-0.5 overflow-x-auto border-b border-[var(--sl-color-gray-5)] px-2" role="tablist" aria-label="Compiler output">
    {primary.map(([id, label, title], index) => (
      <button
        type="button"
        role="tab"
        id={`tab-${id}`}
        aria-controls={`panel-${id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-inspector-tab={id}
        title={title}
        class={tabClass}
      >
        {label}
      </button>
    ))}
    <button
      type="button"
      class={tabClass}
      data-more-button
      popovertarget="more-menu"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="more-menu"
      title="More compiler output: AST, Explain, Tokens, Metrics"
    >
      <span data-more-label>More</span>
      <span aria-hidden="true"> ▾</span>
    </button>
  </div>

  <div id="more-menu" class="app-share-pop" popover="auto" data-more-menu role="menu" aria-label="More compiler output">
    {secondary.map(([id, label, title]) => (
      <button
        type="button"
        role="tab"
        id={`tab-${id}`}
        aria-controls={`panel-${id}`}
        aria-selected="false"
        tabindex={-1}
        data-inspector-tab={id}
        title={title}
        class="app-share-pop__social"
      >
        <span>{label}</span>
      </button>
    ))}
  </div>

  <div class="relative min-h-0 flex-1">
    <section
      role="tabpanel"
      id="panel-response"
      aria-labelledby="tab-response"
      class="absolute inset-0 overflow-auto"
      data-inspector-panel="response"
    >
      <div class="grid min-h-full content-start gap-3 p-4" data-response-rich></div>
      <pre class="pg-hl m-0 hidden min-h-full whitespace-pre-wrap break-words p-4 font-mono text-[0.72rem] leading-5 text-[var(--sl-color-gray-2)]" data-output="response">The Result tab needs a reachable Qdrant. Everything else runs offline.</pre>
    </section>
    <section class="absolute inset-0 overflow-auto" role="tabpanel" id="panel-plan" aria-labelledby="tab-plan" data-inspector-panel="plan" hidden>
      <div class="mx-auto grid h-full w-full max-w-[640px] content-start justify-items-stretch gap-3 p-4">
        <div class="grid h-full place-content-center justify-items-center p-8 text-center" data-empty-plan>
          <p class="mono-label m-0">Plan</p>
          <p class="m-0 mt-3 max-w-64 font-mono text-[0.72rem] leading-relaxed text-[var(--sl-color-gray-3)]">
            Paste a statement or load an example. Parsing runs locally; nothing leaves this tab.
          </p>
        </div>

        <div class="flex h-full min-h-0 flex-col" data-plan-card hidden>
          <div class="grid content-start gap-3 rounded-[var(--q-r)] border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] p-4">
            <div class="flex items-center gap-2">
              <span class="rounded border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-7)] px-1.5 py-1 font-mono text-[0.62rem] font-bold text-[var(--sl-color-gray-1)]" data-route-method>POST</span>
              <code class="min-w-0 flex-1 truncate font-mono text-[0.72rem] text-[var(--sl-color-accent-high)]" data-route-path>/collections/…</code>
            </div>
            <dl class="m-0 grid gap-1.5">
              <div class="flex justify-between gap-4 border-b border-[var(--sl-color-gray-5)] px-2 py-2 text-xs"><dt class="m-0 text-[var(--sl-color-gray-3)]">Statement</dt><dd class="m-0 font-mono text-[var(--sl-color-gray-2)]" data-route-type>Pending</dd></div>
              <div class="flex justify-between gap-4 border-b border-[var(--sl-color-gray-5)] px-2 py-2 text-xs"><dt class="m-0 text-[var(--sl-color-gray-3)]">Transport</dt><dd class="m-0 font-mono text-[var(--sl-color-gray-2)]">Qdrant REST</dd></div>
              <div class="flex justify-between gap-4 px-2 py-2 text-xs"><dt class="m-0 text-[var(--sl-color-gray-3)]">Policy</dt><dd class="m-0 font-mono text-[var(--sl-color-gray-2)]" data-route-policy>Source only</dd></div>
            </dl>
          </div>

          <div class="flex min-h-0 flex-1 flex-col" data-routes-section>
            <header class="flex shrink-0 items-baseline justify-between gap-3 px-1 pt-1 pb-2">
              <span class="mono-label">Compiled statements</span>
              <span class="font-mono text-[0.6875rem] text-[var(--sl-color-gray-4)]" data-routes-count>0</span>
            </header>
            <div class="grid min-h-0 content-start gap-2 overflow-y-auto pb-3" data-routes-list role="listbox" aria-label="Compiled Qdrant routes"></div>
          </div>
        </div>
      </div>
    </section>

    {["wire", "ast", "tokens", "explain", "metrics"].map((id) => (
      <section
        role="tabpanel"
        id={`panel-${id}`}
        aria-labelledby={`tab-${id}`}
        class="absolute inset-0 overflow-auto"
        data-inspector-panel={id}
        hidden
      >
        <pre class="pg-hl m-0 min-h-full whitespace-pre-wrap break-words p-4 font-mono text-[0.72rem] leading-5 text-[var(--sl-color-gray-2)]" data-output={id}>{`Preparing the parser…`}</pre>
      </section>
    ))}
  </div>
</section>
