<section class="flex min-h-0 min-w-0 flex-col" aria-labelledby="inspector-title">
  <div class="flex min-h-16 items-center justify-between gap-3 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-4 py-3">
    <div>
      <span class="block font-mono text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-[var(--sl-color-accent)]">Compiler</span>
      <h2 id="inspector-title" class="!m-0 !mt-0.5 font-(family-name:--sl-font) !text-[0.95rem] !font-semibold text-[var(--sl-color-white)]">Inspector</h2>
    </div>
    <label>
      <span class="sr-only">Statement</span>
      <select class="min-h-9 min-w-28 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-2 font-mono text-[0.75rem] text-[var(--sl-color-gray-1)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" data-statement-select name="statement-select" aria-label="Inspect statement" disabled>
        <option value="0">Statement 1</option>
      </select>
    </label>
  </div>

  <div class="flex gap-0.5 overflow-x-auto border-b border-[var(--sl-color-gray-5)] px-2 pt-2" role="tablist" aria-label="Compiler output">
    {[
      ["plan", "Plan"],
      ["response", "Result"],
      ["ast", "AST"],
      ["wire", "Wire"],
      ["explain", "Explain"],
      ["tokens", "Tokens"],
      ["metrics", "Metrics"],
    ].map(([id, label], index) => (
      <button
        type="button"
        role="tab"
        id={`tab-${id}`}
        aria-controls={`panel-${id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        data-inspector-tab={id}
        class="shrink-0 border-x-0 border-t-0 border-b-2 border-transparent bg-transparent px-3 py-2.5 font-mono text-[0.75rem] text-[var(--sl-color-gray-3)] hover:text-[var(--sl-color-gray-1)] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--sl-color-accent)] aria-selected:border-[var(--sl-color-accent)] aria-selected:text-[var(--sl-color-white)]"
        >
        {label}
      </button>
    ))}
  </div>

  <div class="relative min-h-0 flex-1">
    <section class="absolute inset-0 overflow-auto" role="tabpanel" id="panel-plan" aria-labelledby="tab-plan" data-inspector-panel="plan">
      <div class="grid h-full place-content-center justify-items-center p-8 text-center" data-empty-plan>
        <span class="mb-4 grid size-12 place-items-center rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] font-mono text-xl text-[var(--sl-color-accent)]">Q</span>
        <h3 class="!m-0 font-(family-name:--sl-font) !text-sm !font-semibold text-[var(--sl-color-gray-1)]">Plan appears here</h3>
        <p class="mt-2 max-w-72 text-xs leading-5 text-[var(--sl-color-gray-3)]">Edit a valid statement to inspect its compiled Qdrant route.</p>
      </div>

      <div class="flex h-full flex-col" data-plan-card hidden>
        <div class="shrink-0 p-4">
          <div class="flex items-center gap-2 rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] p-3">
            <span class="rounded border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-7)] px-1.5 py-1 font-mono text-[0.62rem] font-bold text-[var(--sl-color-gray-1)]" data-route-method>POST</span>
            <code class="min-w-0 truncate text-xs text-[var(--sl-color-accent-high)]" data-route-path>/collections/…</code>
          </div>
          <dl class="mt-3 grid gap-1.5">
            <div class="flex justify-between gap-4 border-b border-[var(--sl-color-gray-5)] px-2 py-2 text-xs"><dt class="text-[var(--sl-color-gray-3)]">Statement</dt><dd class="m-0 font-mono text-[var(--sl-color-gray-2)]" data-route-type>Pending</dd></div>
            <div class="flex justify-between gap-4 border-b border-[var(--sl-color-gray-5)] px-2 py-2 text-xs"><dt class="text-[var(--sl-color-gray-3)]">Transport</dt><dd class="m-0 font-mono text-[var(--sl-color-gray-2)]">Qdrant REST</dd></div>
            <div class="flex justify-between gap-4 border-b border-[var(--sl-color-gray-5)] px-2 py-2 text-xs"><dt class="text-[var(--sl-color-gray-3)]">Policy</dt><dd class="m-0 font-mono text-[var(--sl-color-gray-2)]" data-route-policy>Source only</dd></div>
          </dl>
        </div>

        <div class="flex min-h-0 flex-1 flex-col border-t border-[var(--sl-color-gray-5)]" data-routes-section>
          <header class="flex shrink-0 items-baseline justify-between gap-3 px-4 pt-3 pb-2">
            <span class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-[var(--sl-color-gray-3)]">Compiled statements</span>
            <span class="font-mono text-[0.68rem] text-[var(--sl-color-gray-4)]" data-routes-count>0</span>
          </header>
          <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-3" data-routes-list role="listbox" aria-label="Compiled Qdrant routes"></div>
        </div>
      </div>
    </section>

    {["wire", "ast", "tokens", "explain", "response", "metrics"].map((id) => (
      <section
        role="tabpanel"
        id={`panel-${id}`}
        aria-labelledby={`tab-${id}`}
        class="absolute inset-0 overflow-auto"
        data-inspector-panel={id}
        hidden
      >
        <pre class="m-0 min-h-full overflow-auto whitespace-pre-wrap break-words p-4 font-mono text-xs leading-5 text-[var(--sl-color-gray-2)]" data-output={id}>No {id} output yet.</pre>
      </section>
    ))}
  </div>
</section>
