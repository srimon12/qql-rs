<dialog class="app-dialog" id="export-dialog" aria-labelledby="export-title" data-app-dialog>
  <div class="flex max-h-[90vh] flex-col">
    <header class="flex items-start justify-between gap-4 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-5 py-4">
      <div class="min-w-0">
        <p class="mono-label m-0">Host integration</p>
        <h2 id="export-title" class="m-0 mt-1 text-lg font-semibold tracking-[-0.01em] text-[var(--sl-color-white)]">Export SDK code</h2>
        <p class="m-0 mt-1 text-xs leading-5 text-[var(--sl-color-gray-3)]">Use the same validated QQL source from Rust, Python, Node.js, or cURL.</p>
      </div>
      <button class="app-icon-btn" type="button" data-close-dialog aria-label="Close exporter">×</button>
    </header>

    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--sl-color-gray-5)] px-4 py-3">
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="SDK language">
        {["python", "node", "rust", "curl"].map((language, index) => (
          <button
            type="button"
            aria-pressed={index === 0 ? "true" : "false"}
            data-export-tab={language}
            class="shrink-0 rounded-full border border-[var(--sl-color-gray-5)] px-2.5 py-1 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)] transition-colors hover:border-[var(--sl-color-gray-4)] hover:text-[var(--sl-color-gray-1)] aria-pressed:border-[var(--sl-color-accent)] aria-pressed:text-[var(--sl-color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]"
          >
            {language === "node" ? "Node.js" : language}
          </button>
        ))}
      </div>
      <button class="app-action app-action--lg shrink-0" type="button" data-copy-export>Copy code</button>
    </div>

    <pre class="m-0 min-h-0 flex-1 overflow-auto whitespace-pre-wrap break-words p-5 font-mono text-xs leading-5 text-[var(--sl-color-gray-2)]" data-export-output>Generate a valid plan before exporting.</pre>
  </div>
</dialog>
