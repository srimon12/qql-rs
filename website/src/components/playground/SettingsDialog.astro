<dialog class="m-auto w-[min(calc(100%-2rem),38rem)] max-h-[90vh] overflow-hidden rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] p-0 text-[var(--sl-color-gray-1)] shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm" id="settings-dialog" aria-labelledby="settings-title" data-app-dialog>
  <form class="flex max-h-[90vh] flex-col" data-settings-form>
    <header class="flex items-start justify-between gap-4 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] p-5">
      <div>
        <span class="block font-mono text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-[var(--sl-color-accent)]">Runtime</span>
        <h2 id="settings-title" class="!m-0 !mt-1 font-(family-name:--sl-font) !text-xl !font-semibold text-[var(--sl-color-white)]">Connection and embeddings</h2>
        <p class="mt-1 text-xs leading-5 text-[var(--sl-color-gray-3)]">Stored only in this browser. QQL is sent directly to your configured Qdrant endpoint.</p>
      </div>
      <button class="grid size-8 place-items-center rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] text-lg text-[var(--sl-color-gray-2)]" type="button" data-close-dialog aria-label="Close settings">×</button>
    </header>

    <div class="grid gap-4 overflow-y-auto p-5">
      <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
        <span>Qdrant REST URL</span>
        <input class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="qdrantUrl" type="url" required placeholder="http://localhost:6333" />
      </label>
      <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
        <span>Qdrant API key <small>optional</small></span>
        <input class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="qdrantKey" type="password" autocomplete="off" />
      </label>
      <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
        <span>Embedding provider</span>
        <select class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="embedProvider">
          <option value="browser">In-browser MiniLM</option>
          <option value="http">OpenAI-compatible HTTP</option>
          <option value="none">None: raw vectors only</option>
        </select>
      </label>
      <fieldset class="grid gap-3 rounded-lg border border-[var(--sl-color-gray-5)] p-3" data-http-embed-fields>
        <legend class="px-1 text-xs font-medium text-[var(--sl-color-gray-2)]">HTTP embedder</legend>
        <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
          <span>Endpoint</span>
          <input class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="embedUrl" type="url" placeholder="http://localhost:11434/v1/embeddings" />
        </label>
        <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
          <span>Model</span>
          <input class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="embedModel" type="text" />
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
            <span>Dimension</span>
            <input class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="embedDim" type="number" min="1" step="1" />
          </label>
          <label class="grid gap-1.5 text-xs font-medium text-[var(--sl-color-gray-2)]">
            <span>API key <small>optional</small></span>
            <input class="min-h-10 rounded-md border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3 text-sm text-[var(--sl-color-gray-1)]" name="embedKey" type="password" autocomplete="off" />
          </label>
        </div>
      </fieldset>
    </div>

    <footer class="flex flex-col items-stretch justify-between gap-3 border-t border-[var(--sl-color-gray-5)] p-4 sm:flex-row sm:items-center">
      <span class="max-w-md text-xs leading-5 text-[var(--sl-color-gray-3)]" data-embed-status>Browser model loads only when execution needs text embeddings.</span>
      <button class="min-h-9 rounded-md bg-[var(--sl-color-accent)] px-3 font-mono text-xs font-semibold text-white hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" type="submit">Save connection</button>
    </footer>
  </form>
</dialog>
