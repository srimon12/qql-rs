---
interface Props {
  heading: string;
  rows: readonly { label: string; body: string }[];
}

const { heading, rows } = Astro.props;
---

<section class="landing-section landing-section--tight" aria-labelledby="why-heading">
  <div class="landing-shell landing-fade-up">
    <h2 id="why-heading">{heading}</h2>
    <ul class="landing-why">
      {
        rows.map((row) => (
          <li class="landing-why__row">
            <p class="landing-why__label">{row.label}</p>
            <p class="landing-why__body">{row.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
