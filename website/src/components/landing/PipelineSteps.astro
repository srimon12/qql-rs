---
interface Props {
	heading: string;
	sub: string;
	steps: readonly { step: string; title: string; detail: string }[];
}

const { heading, sub, steps } = Astro.props;
---

<section class="landing-section" aria-labelledby="pipeline-heading">
  <div class="landing-shell landing-fade-up">
    <header class="landing-section__head">
      <h2 id="pipeline-heading">{heading}</h2>
      <p class="landing-section__sub">{sub}</p>
    </header>

    <ol class="landing-pipeline">
      {
        steps.map((item) => (
          <li class="landing-pipeline__step">
            <span class="landing-pipeline__num">{item.step}</span>
            <h3 class="landing-pipeline__title">{item.title}</h3>
            <p class="landing-pipeline__detail">{item.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
