---
import { Code } from "@astrojs/starlight/components";
import CopyButton from "@qql/ui/CopyButton.astro";

interface Props {
	heading: string;
	sub: string;
	guideHref: string;
	guideLabel: string;
	hybridQql: string;
	tenantQql: string;
	filtersQql: string;
	stats: readonly { value: string; label: string }[];
}

const {
	heading,
	sub,
	guideHref,
	guideLabel,
	hybridQql,
	tenantQql,
	filtersQql,
	stats,
} = Astro.props;

// ── Scenario 1: Hybrid Search (Dense + Sparse RRF) ─────────────────────────
// Vectors are display-truncated to (…) so the line-count story reads at a
// glance; the QQL pane is the real 7-line statement.

const restHybrid = `{
  "prefetch": [
    {
      "query": { "nearest": [[-0.83, 0.32, …, 0.83]] },
      "using": "dense_vec",
      "filter": {
        "must": [{
          "key": "status",
          "match": { "value": "active" }
        }]
      },
      "limit": 100
    },
    {
      "query": { "nearest": { "indices": [3719, 12808, 41172], "values": [0.72, 1.34, 0.41] } },
      "using": "bm25_vec",
      "filter": {
        "must": [{
          "key": "status",
          "match": { "value": "active" }
        }]
      },
      "limit": 100
    }
  ],
  "query": { "fusion": "rrf" },
  "limit": 10
}`;

const pythonHybrid = `results = client.query_points(
    collection_name="docs",
    prefetch=[
        models.Prefetch(
            query=[[-0.83, 0.32, …, 0.83]],
            using="dense_vec",
            filter=models.Filter(must=[
                models.FieldCondition(
                    key="status",
                    match=models.MatchValue(
                        value="active"
                    ),
                )
            ]),
            limit=100,
        ),
        models.Prefetch(
            query=models.SparseVector(
                indices=[3719, 12808, 41172],
                values=[0.72, 1.34, 0.41],
            ),
            using="bm25_vec",
            filter=models.Filter(must=[
                models.FieldCondition(
                    key="status",
                    match=models.MatchValue(
                        value="active"
                    ),
                )
            ]),
            limit=100,
        ),
    ],
    query=models.FusionQuery(fusion=models.Fusion.RRF),
    limit=10,
)`;

const tsHybrid = `const results = await client.query("docs", {
  prefetch: [
    {
      query: [[-0.83, 0.32, …, 0.83]],
      using: "dense_vec",
      filter: {
        must: [
          { key: "status", match: { value: "active" } },
        ],
      },
      limit: 100,
    },
    {
      query: { indices: [3719, 12808, 41172], values: [0.72, 1.34, 0.41] },
      using: "bm25_vec",
      filter: {
        must: [
          { key: "status", match: { value: "active" } },
        ],
      },
      limit: 100,
    },
  ],
  query: { fusion: "rrf" },
  limit: 10,
});`;

const rustHybrid = `let response = client.query(
    QueryPointsBuilder::new("docs")
        .add_prefetch(
            PrefetchQueryBuilder::default()
                .query(Query::new_nearest(vec![-0.83, 0.32, …, 0.83]))
                .using("dense_vec")
                .filter(active_filter.clone())
                .limit(100u64),
        )
        .add_prefetch(
            PrefetchQueryBuilder::default()
                .query(Query::new_nearest(SparseVector {
                    indices: vec![3719, 12808, 41172],
                    values: vec![0.72, 1.34, 0.41],
                }))
                .using("bm25_vec")
                .filter(active_filter)
                .limit(100u64),
        )
        .query(Query::new_fusion(Fusion::Rrf))
        .limit(10u64),
).await?;`;

const goHybrid = `res, err := client.Query(ctx, &qdrant.QueryPoints{
    CollectionName: "docs",
    Prefetch: []*qdrant.PrefetchQuery{
        {
            Query: qdrant.NewQueryDense([]float32{-0.83, 0.32, …, 0.83}),
            Using: qdrant.Ptr("dense_vec"),
            Filter: &qdrant.Filter{
                Must: []*qdrant.Condition{
                    qdrant.NewMatch("status", "active"),
                },
            },
            Limit: qdrant.Ptr(uint64(100)),
        },
        {
            Query: qdrant.NewQuerySparse([]uint32{3719, 12808, 41172}, []float32{0.72, 1.34, 0.41}),
            Using: qdrant.Ptr("bm25_vec"),
            Filter: &qdrant.Filter{
                Must: []*qdrant.Condition{
                    qdrant.NewMatch("status", "active"),
                },
            },
            Limit: qdrant.Ptr(uint64(100)),
        },
    },
    Query: qdrant.NewQueryFusion(qdrant.Fusion_RRF),
    Limit: qdrant.Ptr(uint64(10)),
})`;

// ── Scenario 2: Tenant Shard + Filter ──────────────────────────────────────

const restTenant = `{
  "shard_key": "tenant-corp-99",
  "query": { "nearest": "dense_vec" },
  "filter": {
    "must": [
      {
        "key": "department",
        "match": { "value": "finance" }
      }
    ]
  },
  "limit": 5,
  "with_payload": true
}`;

const pythonTenant = `results = client.query_points(
    collection_name="filings",
    shard_key_selector="tenant-corp-99",
    query=dense_vector,
    query_filter=models.Filter(
        must=[
            models.FieldCondition(
                key="department",
                match=models.MatchValue(value="finance"),
            ),
        ]
    ),
    limit=5,
    with_payload=True,
)`;

const tsTenant = `const results = await client.query("filings", {
  shardKey: "tenant-corp-99",
  query: denseVector,
  filter: {
    must: [
      { key: "department", match: { value: "finance" } },
    ],
  },
  limit: 5,
  withPayload: true,
});`;

const rustTenant = `let response = client.query(
    QueryPointsBuilder::new("filings")
        .shard_key_selector("tenant-corp-99")
        .query(Query::new_nearest(dense_vector))
        .filter(Filter::must([
            Condition::matches("department", "finance"),
        ]))
        .limit(5u64)
        .with_payload(true),
).await?;`;

const goTenant = `res, err := client.Query(ctx, &qdrant.QueryPoints{
    CollectionName: "filings",
    ShardKeySelector: &qdrant.ShardKeySelector{
        ShardKeys: []*qdrant.ShardKey{
            qdrant.NewShardKey("tenant-corp-99"),
        },
    },
    Query: qdrant.NewQueryNearest(denseVector),
    Filter: &qdrant.Filter{
        Must: []*qdrant.Condition{
            qdrant.NewMatch("department", "finance"),
        },
    },
    Limit:       qdrant.Ptr(uint64(5)),
    WithPayload: qdrant.NewWithPayload(true),
})`;

// ── Scenario 3: Boolean Filters ────────────────────────────────────────────

const restFilters = `{
  "query": { "nearest": "dense_vec" },
  "filter": {
    "must": [
      {
        "should": [
          { "key": "category", "match": { "value": "hardware" } },
          { "key": "category", "match": { "value": "tools" } }
        ]
      },
      { "key": "price", "range": { "lte": 1200.0 } },
      { "key": "in_stock", "match": { "value": true } }
    ]
  },
  "limit": 20
}`;

const pythonFilters = `results = client.query_points(
    collection_name="products",
    query=product_vector,
    query_filter=models.Filter(
        must=[
            models.Filter(
                should=[
                    models.FieldCondition(
                        key="category",
                        match=models.MatchValue(value="hardware"),
                    ),
                    models.FieldCondition(
                        key="category",
                        match=models.MatchValue(value="tools"),
                    ),
                ]
            ),
            models.FieldCondition(
                key="price",
                range=models.Range(lte=1200.0),
            ),
            models.FieldCondition(
                key="in_stock",
                match=models.MatchValue(value=True),
            ),
        ]
    ),
    limit=20,
)`;

const tsFilters = `const results = await client.query("products", {
  query: productVector,
  filter: {
    must: [
      {
        should: [
          { key: "category", match: { value: "hardware" } },
          { key: "category", match: { value: "tools" } },
        ],
      },
      { key: "price", range: { lte: 1200.0 } },
      { key: "in_stock", match: { value: true } },
    ],
  },
  limit: 20,
});`;

const rustFilters = `let filter = Filter::must([
    Condition::should([
        Condition::matches("category", "hardware"),
        Condition::matches("category", "tools"),
    ]),
    Condition::range("price", Range {
        lte: Some(1200.0),
        ..Default::default()
    }),
    Condition::matches("in_stock", true),
]);

let response = client.query(
    QueryPointsBuilder::new("products")
        .query(Query::new_nearest(product_vector))
        .filter(filter)
        .limit(20u64),
).await?;`;

const goFilters = `res, err := client.Query(ctx, &qdrant.QueryPoints{
    CollectionName: "products",
    Query: qdrant.NewQueryNearest(productVector),
    Filter: &qdrant.Filter{
        Must: []*qdrant.Condition{
            qdrant.NewFilterCondition(&qdrant.Filter{
                Should: []*qdrant.Condition{
                    qdrant.NewMatch("category", "hardware"),
                    qdrant.NewMatch("category", "tools"),
                },
            }),
            qdrant.NewRange("price", &qdrant.Range{
                Lte: qdrant.Ptr(1200.0),
            }),
            qdrant.NewMatch("in_stock", true),
        },
    },
    Limit: qdrant.Ptr(uint64(20)),
})`;

const FORMATS = [
	{
		id: "python",
		label: "Python",
		lang: "python",
		badge: "qdrant-client",
		warn: "Nested model graph · vectors embedded out-of-band",
	},
	{
		id: "typescript",
		label: "TypeScript",
		lang: "typescript",
		badge: "@qdrant/js-client-rest",
		warn: "Nested request objects · vectors embedded out-of-band",
	},
	{
		id: "rust",
		label: "Rust",
		lang: "rust",
		badge: "qdrant-client crate",
		warn: "Builder + protobuf plumbing · vectors embedded out-of-band",
	},
	{
		id: "go",
		label: "Go",
		lang: "go",
		badge: "go-client/qdrant",
		warn: "Protobuf request graph · vectors embedded out-of-band",
	},
	{
		id: "rest",
		label: "REST JSON",
		lang: "json",
		badge: "HTTP REST API",
		warn: "Hand-built JSON · dense vector inlined by hand",
	},
] as const;

const presets = [
	{
		id: "hybrid",
		title: "Hybrid RRF",
		badge: "Dense + Sparse",
		qql: hybridQql,
		playgroundHref: `/playground/?q=${encodeURIComponent(hybridQql)}`,
		honesty:
			"Native panes carry precomputed dense vectors from an out-of-band embedding step the official SDKs can't express. QQL resolves TEXT and BM25 in-process. Line counts exclude that pipeline on both sides.",
		footNote: "Fuses dense + sparse inside Qdrant",
		codes: {
			rest: restHybrid,
			python: pythonHybrid,
			typescript: tsHybrid,
			rust: rustHybrid,
			go: goHybrid,
		},
	},
	{
		id: "tenant",
		title: "Shard + filter",
		badge: "Multi-tenancy",
		qql: tenantQql,
		playgroundHref: `/playground/?q=${encodeURIComponent(tenantQql)}`,
		honesty:
			"dense_vector arrives precomputed from an out-of-band embedding step the official SDKs can't express. QQL resolves TEXT in-process. Line counts exclude that pipeline on both sides.",
		footNote: "Shard-routed, filter pushed down",
		codes: {
			rest: restTenant,
			python: pythonTenant,
			typescript: tsTenant,
			rust: rustTenant,
			go: goTenant,
		},
	},
	{
		id: "filters",
		title: "Boolean filters",
		badge: "Compound logic",
		qql: filtersQql,
		playgroundHref: `/playground/?q=${encodeURIComponent(filtersQql)}`,
		honesty:
			"productVector arrives precomputed from an out-of-band embedding step the official SDKs can't express. QQL resolves TEXT in-process. Line counts exclude that pipeline on both sides.",
		footNote: "Boolean tree lowered to one filter",
		codes: {
			rest: restFilters,
			python: pythonFilters,
			typescript: tsFilters,
			rust: rustFilters,
			go: goFilters,
		},
	},
] as const;

const lines = (source: string) => source.trim().split("\n").length;
---

<section class="border-t border-[var(--sl-color-gray-5)] py-[clamp(4rem,8vw,6.5rem)]" aria-labelledby="problem-heading">
  <div class="shell">
    <header class="max-w-[44rem] reveal">
      <h2 id="problem-heading" class="h-section m-0">{heading}</h2>
      <p class="m-0 mt-4 text-[1.0625rem] leading-[1.6] text-[var(--sl-color-gray-2)]">{sub}</p>
    </header>

    <div class="mt-10" data-compare>
      {/* ── Scenario tabs ── */}
      <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
        <div class="flex flex-wrap gap-1" role="tablist" aria-label="Query scenarios">
          {presets.map((preset, idx) => (
            <button
              type="button"
              role="tab"
              id={`compare-tab-${preset.id}`}
              class="flex flex-col gap-0.5 border-b-2 border-transparent px-3 py-2.5 text-left text-[var(--sl-color-gray-2)] transition-colors hover:text-[var(--sl-color-gray-1)] aria-selected:border-[var(--sl-color-accent)] aria-selected:text-[var(--sl-color-white)]"
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`compare-panel-${preset.id}`}
              tabindex={idx === 0 ? 0 : -1}
              data-preset={preset.id}
            >
              <span class="text-sm font-medium">{preset.title}</span>
              <span class="mono-label text-[0.625rem]">{preset.badge}</span>
            </button>
          ))}
        </div>

        <div class="flex items-center gap-4 pb-2.5">
          <span class="hidden font-mono text-[0.7rem] text-[var(--sl-color-gray-3)] md:inline" data-stat>
            This example: {lines(presets[0].qql)} lines vs {lines(presets[0].codes.python)} in Python
          </span>
          <span class="font-mono text-[0.7rem] text-[var(--sl-color-gray-3)]" data-reduction>
            −{Math.round((1 - lines(presets[0].qql) / lines(presets[0].codes.python)) * 100)}%
          </span>
          <a class="link font-mono text-[0.7rem]" data-play href={presets[0].playgroundHref}>
            Open in playground →
          </a>
        </div>
      </div>

      {/* ── Format switcher ── */}
      <div class="flex flex-wrap items-center gap-2 border-y border-[var(--sl-color-gray-5)] py-3">
        <span class="mono-label mr-1">Against</span>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Target language comparison">
          {FORMATS.map((f, idx) => (
            <button
              type="button"
              class="rounded-full border border-[var(--sl-color-gray-5)] px-3 py-1 font-mono text-[0.72rem] text-[var(--sl-color-gray-2)] transition hover:border-[var(--sl-color-gray-4)] hover:text-[var(--sl-color-white)] aria-pressed:border-[var(--sl-color-accent)] aria-pressed:bg-[var(--sl-color-accent)] aria-pressed:text-white"
              data-format={f.id}
              aria-pressed={idx === 0 ? "true" : "false"}
            >
              {f.label}
            </button>
          ))}
        </div>
      </div>

      {/* ── Scenario panels ── */}
      {presets.map((preset, idx) => (
        <div
          id={`compare-panel-${preset.id}`}
          role="tabpanel"
          aria-labelledby={`compare-tab-${preset.id}`}
          data-panel={preset.id}
          data-play={preset.playgroundHref}
          data-qql-lines={lines(preset.qql)}
          data-rest-lines={lines(preset.codes.rest)}
          data-python-lines={lines(preset.codes.python)}
          data-typescript-lines={lines(preset.codes.typescript)}
          data-rust-lines={lines(preset.codes.rust)}
          data-go-lines={lines(preset.codes.go)}
          hidden={idx !== 0}
          class="pt-6"
        >
          <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
            {/* Left: the declarative statement */}
            <div class="code-card min-w-0">
              <div class="code-card__head">
                <span class="mono-label mono-label--accent">QQL</span>
                <span class="min-w-0 truncate text-[var(--sl-color-gray-3)]">universal query</span>
                <span class="flex items-center gap-2 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)]">
                  {lines(preset.qql)} lines
                  <CopyButton target={`#qql-${preset.id}`} variant="icon" title="Copy QQL" ariaLabel="Copy QQL code" />
                </span>
              </div>
              <div class="code-flat landing-compare__code-wrapper" id={`qql-${preset.id}`}>
                <Code code={preset.qql} lang="qql" frame="none" />
              </div>
              <div class="code-card__foot">
                <span class="flex items-center gap-1.5">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {preset.footNote}
                </span>
              </div>
            </div>

            {/* Right: the verbose native client */}
            <div class="min-w-0">
              {FORMATS.map((f, fIdx) => (
                <div class="code-card" data-raw={f.id} hidden={fIdx !== 0}>
                  <div class="code-card__head">
                    <span class="mono-label mono-label--accent">{f.label}</span>
                    <span class="min-w-0 truncate text-[var(--sl-color-gray-3)]">{f.badge}</span>
                    <span class="flex items-center gap-2 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)]">
                      {lines(preset.codes[f.id])} lines
                      <CopyButton
                        target={`#raw-${preset.id}-${f.id}`}
                        variant="icon"
                        title={`Copy ${f.label} code`}
                        ariaLabel={`Copy ${f.label} code`}
                      />
                    </span>
                  </div>
                  <div class="code-flat landing-compare__code-wrapper" id={`raw-${preset.id}-${f.id}`}>
                    <Code code={preset.codes[f.id]} lang={f.lang} frame="none" />
                  </div>
                  <div class="code-card__foot">
                    <span class="flex items-center gap-1.5">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      {f.warn}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <p class="m-0 mt-4 text-xs leading-5 text-[var(--sl-color-gray-3)]" role="note">{preset.honesty}</p>
        </div>
      ))}

      <div class="mt-8 flex flex-wrap items-baseline justify-between gap-3 border-t border-[var(--sl-color-gray-5)] pt-5">
        <p class="m-0 text-sm text-[var(--sl-color-gray-2)]">
          Declarative queries compile directly to optimized Qdrant REST and gRPC payloads with zero runtime overhead.
        </p>
        <a class="link text-sm" href={guideHref}>{guideLabel} →</a>
      </div>
    </div>

    {/* Proof ruler: replaces the old stats strip. */}
    <dl class="reveal mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-[10px] border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-5)] p-0 sm:grid-cols-3">
      {
        stats.map((item) => (
          <div class="bg-[var(--sl-color-bg)] px-5 py-5">
            <dt class="mono-label m-0">{item.label}</dt>
            <dd class="m-0 mt-2 font-mono text-[1.75rem] leading-none tabular-nums text-[var(--sl-color-white)]">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-compare]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-preset]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const formatBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-format]")];
    const stat = root.querySelector("[data-stat]");
    const reduction = root.querySelector("[data-reduction]");
    const play = root.querySelector<HTMLAnchorElement>("[data-play]");
    const codePanes = [...root.querySelectorAll<HTMLElement>(".landing-compare__code-wrapper pre")];

    const formatLabels: Record<string, string> = {
      rest: "REST JSON",
      python: "Python SDK",
      typescript: "TypeScript SDK",
      rust: "Rust SDK",
      go: "Go SDK",
    };

    const balance = root.querySelector<HTMLInputElement>("[data-balance]");
    const balanceReadout = root.querySelector("[data-balance-readout]");

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let format = "python";
    // Last rendered numbers, so tab/format switches count from truth.
    let shownQqlLines = 0;
    let shownTargetLines = 0;
    let firstSync = true;

    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const tween = (duration: number, render: (eased: number) => void) => {
      if (reduceMotion.matches) {
        render(1);
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        render(easeOut(t));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const countPair = (
      el: Element | null,
      fromA: number,
      toA: number,
      fromB: number,
      toB: number,
      render: (a: number, b: number) => string,
    ) => {
      if (!el) return;
      if (firstSync || reduceMotion.matches || (fromA === toA && fromB === toB)) {
        el.textContent = render(toA, toB);
        return;
      }
      tween(380, (eased) => {
        el.textContent = render(
          Math.round(fromA + (toA - fromA) * eased),
          Math.round(fromB + (toB - fromB) * eased),
        );
      });
    };

    // Scrollable code regions must stay keyboard-reachable (WCAG 2.1): long
    // target lines sit behind horizontal scroll, so focus them when they
    // actually overflow and leave short ones out of the tab order.
    const syncScrollable = () => {
      for (const pre of codePanes) {
        pre.tabIndex = pre.scrollWidth > pre.clientWidth + 1 ? 0 : -1;
      }
    };

    const activePanel = () => panels.find((panel) => !panel.hidden) ?? panels[0];

    const sync = (instant = false) => {
      const panel = activePanel();
      const qqlLines = Number(panel.dataset.qqlLines ?? "5");
      const targetLinesAttr = `${format}Lines`;
      const targetLines = Number(panel.dataset[targetLinesAttr] ?? "20");

      if (stat) {
        const label = formatLabels[format] ?? format.toUpperCase();
        countPair(
          stat,
          shownQqlLines || qqlLines,
          qqlLines,
          shownTargetLines || targetLines,
          targetLines,
          (a, b) => `This example: ${a} lines vs ${b} in ${label}`,
        );
      }
      shownQqlLines = qqlLines;
      shownTargetLines = targetLines;

      if (reduction && targetLines > qqlLines) {
        const pct = Math.round((1 - qqlLines / targetLines) * 100);
        reduction.textContent = `−${pct}%`;
      }

      if (play && panel.dataset.play) {
        play.href = panel.dataset.play;
      }

      root.querySelectorAll<HTMLElement>("[data-raw]").forEach((pane) => {
        pane.hidden = pane.dataset.raw !== format;
      });

      firstSync = false;
      syncScrollable();
    };

    // Preset / Scenario tabs (roving tabindex + arrow-key nav per APG tabs)
    const activatePreset = (tab: HTMLButtonElement) => {
      const id = tab.dataset.preset;
      tabs.forEach((item) => {
        const on = item === tab;
        item.classList.toggle("is-active", on);
        item.setAttribute("aria-selected", String(on));
        item.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
      sync();
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activatePreset(tab));
      tab.addEventListener("keydown", (event) => {
        let next: number | null = null;
        if (event.key === "ArrowRight") next = (idx + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        if (next === null) return;
        event.preventDefault();
        tabs[next].focus();
        activatePreset(tabs[next]);
      });
    });

    // Language Format Button Click
    formatBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.format;
        if (!next) return;
        format = next;
        formatBtns.forEach((item) => {
          const on = item === btn;
          item.classList.toggle("is-active", on);
          item.setAttribute("aria-pressed", String(on));
        });
        sync();
      });
    });

    // Copy buttons are owned by @qql/ui CopyButton (data-copy-target).

    syncScrollable();
    sync(true);
    window.addEventListener("resize", syncScrollable);

    // Pane-balance slider was removed; the null-checked lookup stays so the
    // component script keeps working if the control returns.
    if (balance) {
      const applyBalance = () => {
        const value = Number(balance.value);
        root.style.setProperty("--cq-pct", `${value}%`);
        if (balanceReadout) balanceReadout.textContent = `${value} / ${100 - value}`;
      };
      balance.addEventListener("input", applyBalance);
      applyBalance();
    }
  }
</script>
