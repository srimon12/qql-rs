---
import { Code } from "@astrojs/starlight/components";
import CopyButton from "@qql/ui/CopyButton.astro";

interface Props {
	heading: string;
	sub: string;
	guideHref: string;
	guideLabel: string;
	hybridQql: string;
	tenantQql: string;
	filtersQql: string;
}

const {
	heading,
	sub,
	guideHref,
	guideLabel,
	hybridQql,
	tenantQql,
	filtersQql,
} = Astro.props;

// Every native pane is display-truncated to (…) — the QQL pane is the real
// statement. Native panes inline precomputed vectors from an out-of-band
// embedding step QQL resolves in-process; line counts exclude that pipeline
// on both sides. No pane exceeds ~28 lines (dev inlined 300-float vectors,
// which caused the 416px layout shift this replaces).

const restHybrid = `{
  "prefetch": [
    {
      "query": { "nearest": [[-0.83, 0.32, …, 0.83]] },
      "using": "dense_vec",
      "filter": {
        "must": [{
          "key": "status",
          "match": { "value": "active" }
        }]
      },
      "limit": 100
    },
    {
      "query": { "nearest": { "indices": [3719, 12808, 41172], "values": [0.72, 1.34, 0.41] } },
      "using": "bm25_vec",
      "filter": {
        "must": [{
          "key": "status",
          "match": { "value": "active" }
        }]
      },
      "limit": 100
    }
  ],
  "query": { "fusion": "rrf" },
  "limit": 10
}`;

const pythonHybrid = `results = client.query_points(
    collection_name="docs",
    prefetch=[
        models.Prefetch(
            query=[[-0.83, 0.32, …, 0.83]],
            using="dense_vec",
            filter=status_filter,
            limit=100,
        ),
        models.Prefetch(
            query=models.SparseVector(
                indices=[3719, 12808, 41172],
                values=[0.72, 1.34, 0.41],
            ),
            using="bm25_vec",
            filter=status_filter,
            limit=100,
        ),
    ],
    query=models.FusionQuery(fusion=models.Fusion.RRF),
    limit=10,
)`;

const tsHybrid = `const results = await client.query("docs", {
  prefetch: [
    {
      query: [[-0.83, 0.32, …, 0.83]],
      using: "dense_vec",
      filter: { must: [{ key: "status", match: { value: "active" } }] },
      limit: 100,
    },
    {
      query: { indices: [3719, 12808, 41172], values: [0.72, 1.34, 0.41] },
      using: "bm25_vec",
      filter: { must: [{ key: "status", match: { value: "active" } }] },
      limit: 100,
    },
  ],
  query: { fusion: "rrf" },
  limit: 10,
});`;

const rustHybrid = `let response = client.query(
    QueryPointsBuilder::new("docs")
        .add_prefetch(
            PrefetchQueryBuilder::default()
                .query(Query::new_nearest(vec![-0.83, 0.32, /* …, */ 0.83]))
                .using("dense_vec")
                .filter(active_filter.clone())
                .limit(100u64),
        )
        .add_prefetch(
            PrefetchQueryBuilder::default()
                .query(Query::new_nearest(SparseVector {
                    indices: vec![3719, 12808, 41172],
                    values: vec![0.72, 1.34, 0.41],
                }))
                .using("bm25_vec")
                .filter(active_filter)
                .limit(100u64),
        )
        .query(Query::new_fusion(Fusion::Rrf))
        .limit(10u64),
).await?;`;

const goHybrid = `res, err := client.Query(ctx, &qdrant.QueryPoints{
    CollectionName: "docs",
    Prefetch: []*qdrant.PrefetchQuery{
        {
            Query: qdrant.NewQueryDense([]float32{-0.83, 0.32 /* …, */, 0.83}),
            Using: qdrant.Ptr("dense_vec"),
            Filter: statusFilter,
            Limit: qdrant.Ptr(uint64(100)),
        },
        {
            Query: qdrant.NewQuerySparse([]uint32{3719, 12808, 41172}, []float32{0.72, 1.34, 0.41}),
            Using: qdrant.Ptr("bm25_vec"),
            Filter: statusFilter,
            Limit: qdrant.Ptr(uint64(100)),
        },
    },
    Query: qdrant.NewQueryFusion(qdrant.Fusion_RRF),
    Limit: qdrant.Ptr(uint64(10)),
})`;

const restTenant = `{
  "shard_key": "tenant-corp-99",
  "query": { "nearest": "dense_vec" },
  "filter": {
    "must": [
      {
        "key": "department",
        "match": { "value": "finance" }
      }
    ]
  },
  "limit": 5,
  "with_payload": true
}`;

const pythonTenant = `results = client.query_points(
    collection_name="filings",
    shard_key_selector="tenant-corp-99",
    query=dense_vector,
    query_filter=models.Filter(must=[
        models.FieldCondition(key="department", match=models.MatchValue(value="finance")),
    ]),
    limit=5,
    with_payload=True,
)`;

const tsTenant = `const results = await client.query("filings", {
  shardKey: "tenant-corp-99",
  query: denseVector,
  filter: { must: [{ key: "department", match: { value: "finance" } }] },
  limit: 5,
  withPayload: true,
});`;

const rustTenant = `let response = client.query(
    QueryPointsBuilder::new("filings")
        .shard_key_selector("tenant-corp-99")
        .query(Query::new_nearest(dense_vector))
        .filter(Filter::must([Condition::matches("department", "finance")]))
        .limit(5u64)
        .with_payload(true),
).await?;`;

const goTenant = `res, err := client.Query(ctx, &qdrant.QueryPoints{
    CollectionName: "filings",
    ShardKeySelector: &qdrant.ShardKeySelector{
        ShardKeys: []*qdrant.ShardKey{qdrant.NewShardKey("tenant-corp-99")},
    },
    Query: qdrant.NewQueryNearest(denseVector),
    Filter: &qdrant.Filter{
        Must: []*qdrant.Condition{qdrant.NewMatch("department", "finance")},
    },
    Limit: qdrant.Ptr(uint64(5)),
    WithPayload: qdrant.NewWithPayload(true),
})`;

const restFilters = `{
  "query": { "nearest": "dense_vec" },
  "filter": {
    "must": [
      {
        "should": [
          { "key": "category", "match": { "value": "hardware" } },
          { "key": "category", "match": { "value": "tools" } }
        ]
      },
      { "key": "price", "range": { "lte": 1200.0 } },
      { "key": "in_stock", "match": { "value": true } }
    ]
  },
  "limit": 20
}`;

const pythonFilters = `results = client.query_points(
    collection_name="products",
    query=product_vector,
    query_filter=models.Filter(must=[
        models.Filter(should=[
            models.FieldCondition(key="category", match=models.MatchValue(value="hardware")),
            models.FieldCondition(key="category", match=models.MatchValue(value="tools")),
        ]),
        models.FieldCondition(key="price", range=models.Range(lte=1200.0)),
        models.FieldCondition(key="in_stock", match=models.MatchValue(value=True)),
    ]),
    limit=20,
)`;

const tsFilters = `const results = await client.query("products", {
  query: productVector,
  filter: {
    must: [
      {
        should: [
          { key: "category", match: { value: "hardware" } },
          { key: "category", match: { value: "tools" } },
        ],
      },
      { key: "price", range: { lte: 1200.0 } },
      { key: "in_stock", match: { value: true } },
    ],
  },
  limit: 20,
});`;

const rustFilters = `let filter = Filter::must([
    Condition::should([
        Condition::matches("category", "hardware"),
        Condition::matches("category", "tools"),
    ]),
    Condition::range("price", Range { lte: Some(1200.0), ..Default::default() }),
    Condition::matches("in_stock", true),
]);

let response = client.query(
    QueryPointsBuilder::new("products")
        .query(Query::new_nearest(product_vector))
        .filter(filter)
        .limit(20u64),
).await?;`;

const goFilters = `res, err := client.Query(ctx, &qdrant.QueryPoints{
    CollectionName: "products",
    Query: qdrant.NewQueryNearest(productVector),
    Filter: &qdrant.Filter{
        Must: []*qdrant.Condition{
            qdrant.NewFilterCondition(&qdrant.Filter{
                Should: []*qdrant.Condition{
                    qdrant.NewMatch("category", "hardware"),
                    qdrant.NewMatch("category", "tools"),
                },
            }),
            qdrant.NewRange("price", &qdrant.Range{Lte: qdrant.Ptr(1200.0)}),
            qdrant.NewMatch("in_stock", true),
        },
    },
    Limit: qdrant.Ptr(uint64(20)),
})`;

const FORMATS = [
	{
		id: "rest",
		label: "REST JSON",
		lang: "json",
		badge: "POST /points/query",
		warn: "Hand-built JSON · vectors inlined by hand",
	},
	{
		id: "python",
		label: "Python",
		lang: "python",
		badge: "qdrant-client",
		warn: "Nested model graph · vectors inlined by hand",
	},
	{
		id: "typescript",
		label: "TypeScript",
		lang: "typescript",
		badge: "js-client-rest",
		warn: "Nested request objects · vectors inlined by hand",
	},
	{
		id: "rust",
		label: "Rust",
		lang: "rust",
		badge: "qdrant-client crate",
		warn: "Builder plumbing · vectors inlined by hand",
	},
	{
		id: "go",
		label: "Go",
		lang: "go",
		badge: "go-client/qdrant",
		warn: "Protobuf request graph · vectors inlined by hand",
	},
] as const;

type FormatId = (typeof FORMATS)[number]["id"];

const lines = (source: string) => source.trim().split("\n").length;

const scenarios: {
	id: string;
	label: string;
	qql: string;
	codes: Record<FormatId, string>;
	qqlNote: string;
	playgroundHref: string;
}[] = [
	{
		id: "hybrid",
		label: "Hybrid RRF",
		qql: hybridQql,
		codes: {
			rest: restHybrid,
			python: pythonHybrid,
			typescript: tsHybrid,
			rust: rustHybrid,
			go: goHybrid,
		},
		qqlNote: "Dense plus sparse fused in one statement",
		playgroundHref: `/playground/?q=${encodeURIComponent(hybridQql)}`,
	},
	{
		id: "tenant",
		label: "Shard + filter",
		qql: tenantQql,
		codes: {
			rest: restTenant,
			python: pythonTenant,
			typescript: tsTenant,
			rust: rustTenant,
			go: goTenant,
		},
		qqlNote: "Shard-routed, filter pushed down",
		playgroundHref: `/playground/?q=${encodeURIComponent(tenantQql)}`,
	},
	{
		id: "filters",
		label: "Boolean filters",
		qql: filtersQql,
		codes: {
			rest: restFilters,
			python: pythonFilters,
			typescript: tsFilters,
			rust: rustFilters,
			go: goFilters,
		},
		qqlNote: "Boolean tree lowered to one filter",
		playgroundHref: `/playground/?q=${encodeURIComponent(filtersQql)}`,
	},
];

const DEFAULT_FORMAT: FormatId = "rest";
---

<section class="border-t border-[var(--sl-color-gray-5)] py-[clamp(3rem,6vw,4.5rem)]" aria-labelledby="problem-heading">
  <div class="shell">
    <header class="max-w-[44rem] reveal">
      <h2 id="problem-heading" class="h-section m-0">{heading}</h2>
      <p class="m-0 mt-4 text-[1.0625rem] leading-[1.6] text-[var(--sl-color-gray-2)]">{sub}</p>
    </header>

    <div class="mt-8 reveal" data-compare>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div
          class="inline-flex max-w-full flex-wrap gap-1 rounded-[10px] border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] p-1"
          role="tablist"
          aria-label="Query scenarios"
        >
          {scenarios.map((scenario, idx) => (
            <button
              type="button"
              role="tab"
              id={`compare-tab-${scenario.id}`}
              aria-controls={`compare-panel-${scenario.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              tabindex={idx === 0 ? 0 : -1}
              data-scenario={scenario.id}
              class="app-action min-h-9 px-3.5 py-2 text-[0.75rem] aria-selected:bg-[var(--sl-color-gray-7)] aria-selected:text-[var(--sl-color-white)]"
            >
              {scenario.label}
            </button>
          ))}
        </div>
        <a class="link font-mono text-[0.75rem]" data-play href={scenarios[0].playgroundHref}>
          Open in playground →
        </a>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-1" role="group" aria-label="Target client">
        <span class="mono-label mr-1">Target</span>
        {FORMATS.map((format) => (
          <button
            type="button"
            data-target={format.id}
            aria-pressed={format.id === DEFAULT_FORMAT ? "true" : "false"}
            title={`${format.label} (${format.badge})`}
            class="app-action min-h-8 px-3 py-1.5 text-[0.75rem] aria-pressed:bg-[var(--sl-color-gray-7)] aria-pressed:text-[var(--sl-color-white)]"
          >
            {format.label}
          </button>
        ))}
      </div>

      {scenarios.map((scenario, idx) => {
        const qqlLines = lines(scenario.qql);
        const targetLines = lines(scenario.codes[DEFAULT_FORMAT]);
        const reduction = Math.round((1 - qqlLines / targetLines) * 100);
        return (
          <div
            id={`compare-panel-${scenario.id}`}
            role="tabpanel"
            aria-labelledby={`compare-tab-${scenario.id}`}
            data-panel={scenario.id}
            data-play={scenario.playgroundHref}
            data-qql-lines={qqlLines}
            data-rest-lines={lines(scenario.codes.rest)}
            data-python-lines={lines(scenario.codes.python)}
            data-typescript-lines={lines(scenario.codes.typescript)}
            data-rust-lines={lines(scenario.codes.rust)}
            data-go-lines={lines(scenario.codes.go)}
            hidden={idx !== 0}
            class="mt-5"
          >
            <div class="grid items-start gap-4 lg:grid-cols-2">
              {FORMATS.map((format, fIdx) => (
                <article
                  class="code-card flex min-w-0 flex-col"
                  data-target-pane={format.id}
                  hidden={fIdx !== 0}
                >
                  <header class="code-card__head">
                    <span class="mono-label">{format.label}</span>
                    <span class="code-card__meta min-w-0 truncate">{format.badge}</span>
                    <span class="flex shrink-0 items-center gap-2 tabular-nums">
                      <span>{lines(scenario.codes[format.id])} lines</span>
                      <CopyButton
                        target={`#cmp-target-${scenario.id}-${format.id}`}
                        variant="icon"
                        title={`Copy ${format.label} code`}
                        ariaLabel={`Copy ${format.label} code`}
                      />
                    </span>
                  </header>
                  <div
                    class="code-flat h-[16rem] max-h-[16rem] min-h-0 overflow-auto px-4 [mask-image:linear-gradient(to_bottom,#000_88%,transparent)] lg:h-[22rem] lg:max-h-[22rem] [&_pre]:wrap-normal"
                    id={`cmp-target-${scenario.id}-${format.id}`}
                    tabindex="0"
                    role="region"
                    aria-label={`${format.label} ${scenario.label} code, scrollable`}
                  >
                    <Code code={scenario.codes[format.id]} lang={format.lang} frame="none" />
                  </div>
                  <footer class="code-card__foot">
                    <span class="min-w-0 truncate">{format.warn}</span>
                  </footer>
                </article>
              ))}

              <article class="code-card flex min-w-0 flex-col border-[color-mix(in_srgb,var(--sl-color-accent)_40%,var(--sl-color-gray-5))] bg-[color-mix(in_srgb,var(--sl-color-accent)_5%,var(--sl-color-gray-6))] max-lg:order-first">
                <header class="code-card__head">
                  <span class="mono-label mono-label--accent">QQL</span>
                  <span class="code-card__meta min-w-0 truncate">universal query</span>
                  <span class="flex shrink-0 items-center gap-2 tabular-nums">
                    <span>{qqlLines} lines</span>
                    <CopyButton
                      target={`#cmp-qql-${scenario.id}`}
                      variant="icon"
                      title="Copy QQL"
                      ariaLabel="Copy QQL code"
                    />
                  </span>
                </header>
                <div
                  class="code-flat h-[16rem] max-h-[16rem] min-h-0 overflow-auto px-4 [mask-image:linear-gradient(to_bottom,#000_88%,transparent)] lg:h-[22rem] lg:max-h-[22rem] [&_pre]:wrap-normal"
                  id={`cmp-qql-${scenario.id}`}
                  tabindex="0"
                  role="region"
                  aria-label={`QQL ${scenario.label} code, scrollable`}
                >
                  <Code code={scenario.qql} lang="qql" frame="none" />
                </div>
                <footer class="code-card__foot">
                  <span class="min-w-0 truncate">{scenario.qqlNote}</span>
                  <span
                    class="shrink-0 font-semibold text-[var(--sl-color-accent-high)] tabular-nums"
                    data-reduction
                  >
                    −{reduction}%
                  </span>
                </footer>
              </article>
            </div>
          </div>
        );
      })}

      <p class="m-0 mt-4 max-w-[52rem] text-xs leading-5 text-[var(--sl-color-gray-3)]" role="note">
        Native panes inline precomputed vectors from an out-of-band embedding step the
        SDKs and REST API can't express; QQL resolves text in-process. All panes are
        truncated (…); line counts exclude that pipeline on both sides.
      </p>

      <div class="mt-6 flex flex-wrap items-baseline justify-between gap-3 border-t border-[var(--sl-color-gray-5)] pt-5">
        <p class="m-0 text-sm text-[var(--sl-color-gray-2)]">
          Declarative queries compile directly to optimized Qdrant REST and gRPC payloads with zero runtime overhead.
        </p>
        <a class="link text-sm" href={guideHref}>{guideLabel} →</a>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-compare]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-scenario]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const targets = [...root.querySelectorAll<HTMLButtonElement>("[data-target]")];
    const play = root.querySelector<HTMLAnchorElement>("[data-play]");

    // Instant swap between fixed-height panes: the grid never changes size,
    // so content below the comparator does not shift. Only the active
    // scenario panel and the active target pane are unhidden.
    let format = "rest";

    const applyFormat = (panel: HTMLElement) => {
      panel
        .querySelectorAll<HTMLElement>("[data-target-pane]")
        .forEach((pane) => {
          pane.hidden = pane.dataset.targetPane !== format;
        });
      const badge = panel.querySelector("[data-reduction]");
      if (badge) {
        const qqlLines = Number(panel.dataset.qqlLines ?? "0");
        const targetLines = Number(panel.dataset[`${format}Lines`] ?? "0");
        if (qqlLines > 0 && targetLines > qqlLines) {
          badge.textContent = `−${Math.round((1 - qqlLines / targetLines) * 100)}%`;
        }
      }
    };

    const activePanel = () =>
      panels.find((panel) => !panel.hidden) ?? panels[0];

    const activate = (id: string) => {
      for (const tab of tabs) {
        const on = tab.dataset.scenario === id;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.panel !== id;
      }
      const active = activePanel();
      applyFormat(active);
      if (play && active?.dataset.play) play.href = active.dataset.play;
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => activate(tab.dataset.scenario ?? ""));
      tab.addEventListener("keydown", (event) => {
        let next: number | null = null;
        if (event.key === "ArrowRight") next = (idx + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (idx - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        if (next === null) return;
        event.preventDefault();
        tabs[next].focus();
        activate(tabs[next].dataset.scenario ?? "");
      });
    });

    targets.forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.target;
        if (!next) return;
        format = next;
        for (const item of targets) {
          item.setAttribute("aria-pressed", String(item === btn));
        }
        applyFormat(activePanel());
      });
    });
  }
</script>
