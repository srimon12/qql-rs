---
import { Code } from "@astrojs/starlight/components";

interface Props {
  heading: string;
  sub: string;
  guideHref: string;
  guideLabel: string;
  hybridQql: string;
  tenantQql: string;
  filtersQql: string;
}

const { heading, sub, guideHref, guideLabel, hybridQql, tenantQql, filtersQql } =
  Astro.props;

const restHybrid = `{
  "prefetch": [
    {
      "query": { "nearest": "dense_vec" },
      "using": "dense_vec",
      "filter": {
        "must": [{ "key": "status", "match": { "value": "active" } }]
      },
      "limit": 100
    },
    {
      "query": { "nearest": "bm25_vec" },
      "using": "bm25_vec",
      "filter": {
        "must": [{ "key": "status", "match": { "value": "active" } }]
      },
      "limit": 100
    }
  ],
  "query": { "fusion": "rrf" },
  "limit": 10
}`;

const pythonHybrid = `client.query_points(
    collection_name="docs",
    prefetch=[
        models.Prefetch(
            query=models.NearestQuery(nearest="dense_vec"),
            using="dense_vec",
            filter=models.Filter(must=[
                models.FieldCondition(
                    key="status",
                    match=models.MatchValue(value="active"),
                )
            ]),
            limit=100,
        ),
        models.Prefetch(
            query=models.NearestQuery(nearest="bm25_vec"),
            using="bm25_vec",
            filter=models.Filter(must=[
                models.FieldCondition(
                    key="status",
                    match=models.MatchValue(value="active"),
                )
            ]),
            limit=100,
        ),
    ],
    query=models.FusionQuery(fusion=models.Fusion.RRF),
    limit=10,
)`;

const restTenant = `{
  "query": "<dense vector>",
  "filter": {
    "must": [
      { "key": "department", "match": { "value": "finance" } }
    ]
  },
  "limit": 5,
  "with_payload": true
}

POST .../points/query?shard_key=tenant-corp-99`;

const pythonTenant = `client.query_points(
    collection_name="filings",
    shard_key_selector="tenant-corp-99",
    query=dense_embedding_vector,
    query_filter=models.Filter(
        must=[
            models.FieldCondition(
                key="department",
                match=models.MatchValue(value="finance"),
            ),
        ]
    ),
    limit=5,
    with_payload=True,
)`;

const restFilters = `{
  "query": "<dense vector>",
  "filter": {
    "must": [
      {
        "should": [
          { "key": "category", "match": { "value": "hardware" } },
          { "key": "category", "match": { "value": "tools" } }
        ]
      },
      { "key": "price", "range": { "lte": 1200.0 } },
      { "key": "in_stock", "match": { "value": true } }
    ]
  },
  "limit": 20
}`;

const pythonFilters = `client.query_points(
    collection_name="products",
    query=product_query_vector,
    query_filter=models.Filter(
        must=[
            models.Filter(should=[
                models.FieldCondition(
                    key="category",
                    match=models.MatchValue(value="hardware"),
                ),
                models.FieldCondition(
                    key="category",
                    match=models.MatchValue(value="tools"),
                ),
            ]),
            models.FieldCondition(
                key="price",
                range=models.Range(lte=1200.0),
            ),
            models.FieldCondition(
                key="in_stock",
                match=models.MatchValue(value=True),
            ),
        ]
    ),
    limit=20,
)`;

const presets = [
  {
    id: "hybrid",
    title: "Hybrid RRF",
    qql: hybridQql,
    playgroundHref: `/playground/?q=${encodeURIComponent(hybridQql)}`,
    rest: restHybrid,
    python: pythonHybrid,
  },
  {
    id: "tenant",
    title: "Shard + filter",
    qql: tenantQql,
    playgroundHref: `/playground/?q=${encodeURIComponent(tenantQql)}`,
    rest: restTenant,
    python: pythonTenant,
  },
  {
    id: "filters",
    title: "Boolean filters",
    qql: filtersQql,
    playgroundHref: `/playground/?q=${encodeURIComponent(filtersQql)}`,
    rest: restFilters,
    python: pythonFilters,
  },
] as const;

const lines = (source: string) => source.trim().split("\n").length;
---

<section class="landing-section" aria-labelledby="problem-heading">
  <div class="landing-shell landing-fade-up">
    <header class="landing-section__head">
      <h2 id="problem-heading">{heading}</h2>
      <p class="landing-section__sub">{sub}</p>
    </header>

    <div class="landing-compare" data-compare>
      <div class="landing-compare__tabs" role="tablist" aria-label="Query examples">
        {
          presets.map((preset, idx) => (
            <button
              type="button"
              role="tab"
              id={`compare-tab-${preset.id}`}
              class:list={["landing-compare__tab", { "is-active": idx === 0 }]}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`compare-panel-${preset.id}`}
              data-preset={preset.id}
            >
              {preset.title}
            </button>
          ))
        }
      </div>

      <div class="landing-compare__toolbar">
        <div class="landing-compare__modes" role="radiogroup" aria-label="Compare against">
          <button type="button" class="is-active" data-format="rest" aria-pressed="true">
            JSON
          </button>
          <button type="button" data-format="python" aria-pressed="false">
            Python
          </button>
        </div>
        <p class="landing-compare__stat" data-stat>
          {lines(presets[0].qql)} lines vs {lines(presets[0].rest)}
        </p>
        <a class="landing-compare__try" data-play href={presets[0].playgroundHref}>
          Open in playground
        </a>
      </div>

      {
        presets.map((preset, idx) => (
          <div
            class="landing-compare__panel"
            id={`compare-panel-${preset.id}`}
            role="tabpanel"
            aria-labelledby={`compare-tab-${preset.id}`}
            data-panel={preset.id}
            data-play={preset.playgroundHref}
            data-qql-lines={lines(preset.qql)}
            data-rest-lines={lines(preset.rest)}
            data-python-lines={lines(preset.python)}
            hidden={idx !== 0}
          >
            <div class="landing-compare__split" data-split>
              <div class="landing-compare__pane">
                <header>
                  <span>QQL</span>
                  <span>{lines(preset.qql)} lines</span>
                </header>
                <Code code={preset.qql} lang="qql" frame="none" />
              </div>

              <button
                type="button"
                class="landing-compare__handle"
                data-split-handle
                aria-label="Resize comparison"
              ></button>

              <div class="landing-compare__stack">
                <div class="landing-compare__pane" data-raw="rest">
                  <header>
                    <span>REST JSON</span>
                    <span>{lines(preset.rest)} lines</span>
                  </header>
                  <Code code={preset.rest} lang="json" frame="none" />
                </div>
                <div class="landing-compare__pane" data-raw="python" hidden>
                  <header>
                    <span>Python SDK</span>
                    <span>{lines(preset.python)} lines</span>
                  </header>
                  <Code code={preset.python} lang="python" frame="none" />
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="landing-section__foot">
      <a href={guideHref}>{guideLabel} →</a>
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-compare]");
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-preset]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    const formatBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-format]")];
    const stat = root.querySelector("[data-stat]");
    const play = root.querySelector<HTMLAnchorElement>("[data-play]");
    let format: "rest" | "python" = "rest";

    const activePanel = () => panels.find((panel) => !panel.hidden) ?? panels[0];

    const sync = () => {
      const panel = activePanel();
      const qql = panel.dataset.qqlLines ?? "0";
      const other = format === "rest" ? panel.dataset.restLines : panel.dataset.pythonLines;
      if (stat) stat.textContent = `${qql} lines vs ${other}`;
      if (play && panel.dataset.play) play.href = panel.dataset.play;
      root.querySelectorAll<HTMLElement>("[data-raw]").forEach((pane) => {
        pane.hidden = pane.dataset.raw !== format;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.preset;
        tabs.forEach((item) => {
          const on = item === tab;
          item.classList.toggle("is-active", on);
          item.setAttribute("aria-selected", String(on));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== id;
        });
        sync();
      });
    });

    formatBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.dataset.format;
        if (next !== "rest" && next !== "python") return;
        format = next;
        formatBtns.forEach((item) => {
          const on = item === btn;
          item.classList.toggle("is-active", on);
          item.setAttribute("aria-pressed", String(on));
        });
        sync();
      });
    });

    root.querySelectorAll<HTMLElement>("[data-split-handle]").forEach((handle) => {
      handle.addEventListener("pointerdown", (event) => {
        const split = handle.closest<HTMLElement>("[data-split]");
        if (!split || window.matchMedia("(max-width: 51.99rem)").matches) return;
        event.preventDefault();
        handle.setPointerCapture(event.pointerId);
        const rect = split.getBoundingClientRect();
        const move = (ev: PointerEvent) => {
          const ratio = (ev.clientX - rect.left) / rect.width;
          const clamped = Math.min(0.68, Math.max(0.28, ratio));
          split.style.setProperty("--split", `${(clamped * 100).toFixed(1)}%`);
        };
        const up = () => {
          handle.releasePointerCapture(event.pointerId);
          handle.removeEventListener("pointermove", move);
          handle.removeEventListener("pointerup", up);
        };
        handle.addEventListener("pointermove", move);
        handle.addEventListener("pointerup", up);
      });
    });
  }
</script>
