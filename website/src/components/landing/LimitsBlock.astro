---
interface Props {
  statement: string;
  body: string;
  foot: string;
}

const { statement, body, foot } = Astro.props;
---

<section class="landing-limits" aria-labelledby="limits-heading">
  <div class="landing-shell landing-fade-up">
    <div class="landing-limits__inner">
      <p id="limits-heading" class="landing-limits__statement">{statement}</p>
      <div class="landing-limits__aside">
        <p class="landing-limits__body">{body}</p>
        <p class="landing-limits__foot">{foot}</p>
      </div>
    </div>
  </div>
</section>
