---
interface Props {
  heading: string;
  sub: string;
  installs: readonly { name: string; cmd: string; href: string }[];
  footHref?: string;
  footLabel?: string;
}

const { heading, sub, installs, footHref, footLabel } = Astro.props;
---

<section class="landing-section" aria-labelledby="install-heading">
  <div class="landing-shell landing-fade-up">
    <header class="landing-section__head">
      <h2 id="install-heading">{heading}</h2>
      <p class="landing-section__sub">{sub}</p>
    </header>

    <div class="landing-installs">
      {
        installs.map((item) => (
          <a class="landing-install" href={item.href}>
            <span class="landing-install__name">{item.name}</span>
            <code class="landing-install__cmd">{item.cmd}</code>
            <span class="landing-install__arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>

    {
      footHref && footLabel && (
        <p class="landing-section__foot">
          <a href={footHref}>{footLabel} →</a>
        </p>
      )
    }
  </div>
</section>
