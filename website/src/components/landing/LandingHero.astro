---
import CopyButton from "@qql/ui/CopyButton.astro";

interface Props {
	headline: string;
	lede: string;
	eyebrow: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string };
	specimenTitle: string;
	specimenMeta: string;
	specimenRoute: string;
	specimenStatus: string;
	specimenQql: string;
}

const {
	headline,
	lede,
	eyebrow,
	primaryCta,
	secondaryCta,
	specimenTitle,
	specimenMeta,
	specimenRoute,
	specimenStatus,
	specimenQql,
} = Astro.props;
---

<section class="relative overflow-x-clip">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="shell relative grid gap-12 pt-14 pb-16 lg:grid-cols-[minmax(0,34rem)_minmax(0,30rem)] lg:justify-between lg:gap-14 lg:pt-16 lg:pb-24">
    <div class="min-w-0 max-w-[34rem]">
      <p class="mono-label m-0 flex items-center gap-2.5">
        <span class="ping" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 id="hero-headline" class="h-display m-0 mt-5">{headline}</h1>
      <p class="m-0 mt-5 text-[1.125rem] leading-[1.6] text-[var(--sl-color-gray-2)]">
        {lede}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a class="btn btn--primary" href={primaryCta.href}>
          {primaryCta.label}
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>

      <div class="mt-6 flex max-w-full items-center justify-between gap-3 rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-3 py-2">
        <code id="hero-install-cmd" class="min-w-0 overflow-x-auto font-mono text-[0.75rem] text-[var(--sl-color-gray-2)] whitespace-nowrap scrollbar-none" title="curl -fsSL https://raw.githubusercontent.com/srimon12/qql-rs/main/scripts/install.sh | sh">curl -fsSL https://raw.githubusercontent.com/srimon12/qql-rs/main/scripts/install.sh | sh</code>
        <CopyButton
          id="hero-copy-btn"
          target="#hero-install-cmd"
          title="Copy install command"
          ariaLabel="Copy install command"
          class="shrink-0"
        />
      </div>
    </div>

    <figure class="code-card hero-bleed min-w-0 self-start" aria-label={specimenQql}>
      <figcaption class="code-card__head">
        <span class="code-card__tick" aria-hidden="true"></span>
        <span>{specimenTitle}</span>
        <span class="code-card__meta">{specimenMeta}</span>
      </figcaption>

      <div class="code-card__body">
        <pre class="m-0"><code><slot /></code></pre>
      </div>

      <div class="code-card__foot flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <span class="min-w-0 truncate">{specimenRoute}</span>
        <span class="shrink-0">{specimenStatus}</span>
      </div>
    </figure>
  </div>
</section>
