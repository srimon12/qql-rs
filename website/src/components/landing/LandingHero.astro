---
interface Props {
	headline: string;
	lede: string;
	eyebrow: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string };
	specimenTitle: string;
	specimenMeta: string;
	specimenRoute: string;
	specimenStatus: string;
	specimenQql: string;
}

const {
	headline,
	lede,
	eyebrow,
	primaryCta,
	secondaryCta,
	specimenTitle,
	specimenMeta,
	specimenRoute,
	specimenStatus,
	specimenQql,
} = Astro.props;
---

<section class="relative overflow-x-clip">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="shell relative grid gap-12 pt-14 pb-16 lg:grid-cols-[minmax(0,34rem)_minmax(0,30rem)] lg:justify-between lg:gap-14 lg:pt-16 lg:pb-24">
    <div class="min-w-0 max-w-[34rem]">
      <p class="mono-label m-0 flex items-center gap-2.5">
        <span class="ping" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 id="hero-headline" class="h-display m-0 mt-5">{headline}</h1>
      <p class="m-0 mt-5 text-[1.125rem] leading-[1.6] text-[var(--sl-color-gray-2)]">
        {lede}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a class="btn btn--primary" href={primaryCta.href}>
          {primaryCta.label}
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>

      <div class="mt-5 flex items-center gap-3">
        <code id="hero-install-cmd" class="min-w-0 truncate font-mono text-[0.75rem] text-[var(--sl-color-gray-3)]">curl -fsSL https://raw.githubusercontent.com/srimon12/qql-rs/main/scripts/install.sh | sh</code>
        <button
          type="button"
          class="link inline-flex shrink-0 items-center gap-1.5 font-mono text-[0.7rem]"
          id="hero-copy-btn"
          title="Copy install command"
          aria-label="Copy install command"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span class="landing-copy-label">Copy</span>
        </button>
      </div>
    </div>

    <figure class="code-card hero-bleed min-w-0 self-start" aria-label={specimenQql}>
      <figcaption class="code-card__head">
        <span class="code-card__tick" aria-hidden="true"></span>
        <span>{specimenTitle}</span>
        <span class="code-card__meta">{specimenMeta}</span>
      </figcaption>

      <div class="code-card__body">
        <pre class="m-0"><code><slot /></code></pre>
      </div>

      <div class="code-card__foot">
        <span>{specimenRoute}</span>
        <span>{specimenStatus}</span>
      </div>
    </figure>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("hero-copy-btn");
  const cmdEl = document.getElementById("hero-install-cmd");
  const heroCopyLabel = "Copy install command";
  if (copyBtn && cmdEl) {
    const label = copyBtn.querySelector(".landing-copy-label");
    const flash = (text: string, ok: boolean) => {
      copyBtn.classList.toggle("is-copied", ok);
      if (label) label.textContent = text;
      copyBtn.setAttribute(
        "aria-label",
        ok ? `Copied. ${heroCopyLabel}` : `Copy failed. ${heroCopyLabel}`,
      );
      setTimeout(() => {
        copyBtn.classList.remove("is-copied");
        if (label) label.textContent = "Copy";
        copyBtn.setAttribute("aria-label", heroCopyLabel);
      }, 2000);
    };
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(cmdEl.innerText.trim()).then(
        () => flash("Copied", true),
        () => flash("Copy failed", false),
      );
    });
  }
</script>
