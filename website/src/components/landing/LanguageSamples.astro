---
import { Code } from "@astrojs/starlight/components";

interface Props {
	heading: string;
	sub: string;
	footHref: string;
	footLabel: string;
	hybridQql: string;
	facetQql: string;
	formulaQql: string;
}

const { heading, sub, footHref, footLabel, hybridQql, facetQql, formulaQql } =
	Astro.props;

const featured = {
	kind: "Hybrid",
	code: hybridQql,
	caption:
		"Dense and sparse in one statement. The engine fuses, not your client.",
};

const samples = [
	{
		kind: "Formula",
		code: formulaQql,
		caption: "Clamps and curves in one expression, no CASE boilerplate.",
	},
	{
		kind: "Facet",
		code: facetQql,
		caption:
			"Category counts stay in the database, no points pulled into memory.",
	},
].map((sample) => ({
	...sample,
	href: `/playground/?q=${encodeURIComponent(sample.code)}`,
}));

const featuredHref = `/playground/?q=${encodeURIComponent(featured.code)}`;
---

<section class="border-t border-[var(--sl-color-gray-5)] py-[clamp(4rem,8vw,6.5rem)]" aria-labelledby="language-heading">
  <div class="shell">
    <header class="max-w-[44rem] reveal">
      <h2 id="language-heading" class="h-section m-0">{heading}</h2>
      <p class="m-0 mt-4 text-[1.0625rem] leading-[1.6] text-[var(--sl-color-gray-2)]">{sub}</p>
    </header>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <article class="code-card lg:col-span-2">
        <header class="code-card__head">
          <span class="code-card__tick" aria-hidden="true"></span>
          <span class="mono-label">{featured.kind}</span>
          <a class="link font-mono text-[0.6875rem]" href={featuredHref}>Try in playground →</a>
        </header>
        <div class="code-flat px-4">
          <Code code={featured.code} lang="qql" frame="none" />
        </div>
        <div class="code-card__foot">
          <span>{featured.caption}</span>
        </div>
      </article>

      {
        samples.map((sample) => (
          <article class="code-card">
            <header class="code-card__head">
              <span class="code-card__tick" aria-hidden="true"></span>
              <span class="mono-label">{sample.kind}</span>
              <a class="link font-mono text-[0.6875rem]" href={sample.href}>Try in playground →</a>
            </header>
            <div class="code-flat px-4">
              <Code code={sample.code} lang="qql" frame="none" />
            </div>
            <div class="code-card__foot">
              <span>{sample.caption}</span>
            </div>
          </article>
        ))
      }
    </div>

    <p class="m-0 mt-8">
      <a class="link font-mono text-[0.75rem]" href={footHref}>{footLabel} →</a>
    </p>
  </div>
</section>
