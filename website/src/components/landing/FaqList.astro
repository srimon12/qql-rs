---
interface Props {
	heading: string;
	items: readonly { question: string; answer: string }[];
}

const { heading, items } = Astro.props;
---

<section class="landing-section" aria-labelledby="faq-heading">
  <div class="landing-shell landing-fade-up">
    <header class="landing-section__head">
      <h2 id="faq-heading">{heading}</h2>
    </header>

    <div class="landing-faq">
      {
        items.map((item) => (
          <details class="landing-faq__item">
            <summary class="landing-faq__q">{item.question}</summary>
            <p class="landing-faq__a">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
