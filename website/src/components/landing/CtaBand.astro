---
interface Props {
	heading: string;
	body: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string };
}

const { heading, body, primaryCta, secondaryCta } = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="shell reveal py-[clamp(3rem,6vw,4.5rem)]">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div class="max-w-[34rem]">
        <h2 id="cta-heading" class="h-section m-0">{heading}</h2>
        <p class="cta-band__lede m-0 mt-4 text-[1.0625rem] leading-[1.6] text-[var(--sl-color-gray-2)]">{body}</p>
        <p class="cta-band__foot m-0 mt-6 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-[var(--sl-color-gray-3)]">
          no cluster · no signup · MIT
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn--primary" href={primaryCta.href}>
          {primaryCta.label}
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>
    </div>
  </div>
</section>
