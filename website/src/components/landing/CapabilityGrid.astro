---
interface Props {
  heading: string;
  sub: string;
  capabilities: readonly { eyebrow: string; title: string; body: string }[];
}

const { heading, sub, capabilities } = Astro.props;

const featured = capabilities.slice(0, 2);
const rest = capabilities.slice(2);

const featuredCode = [
  `QUERY TEXT 'vector database'`,
  `FROM docs USING HYBRID`,
  `DENSE dense SPARSE bm25 FUSION RRF`,
  `WHERE category = 'tech' LIMIT 10;`,
].join("\n");
---

<section class="landing-section landing-section--muted" aria-labelledby="caps-heading">
  <div class="landing-shell landing-fade-up">
    <header class="landing-section__head">
      <h2 id="caps-heading">{heading}</h2>
      <p class="landing-section__sub">{sub}</p>
    </header>

    <div class="landing-caps landing-caps--bento">
      {
        featured.map((cap, index) => (
          <article class:list={["landing-cap", index === 0 ? "landing-cap--wide" : "landing-cap--side"]}>
            <span class="landing-cap__eyebrow">{cap.eyebrow}</span>
            <h3 class="landing-cap__title">{cap.title}</h3>
            <p class="landing-cap__body">{cap.body}</p>
            {index === 0 ? (
              <pre class="landing-cap__code" aria-label="QQL hybrid query example"><code>{featuredCode}</code></pre>
            ) : (
              <div class="landing-cap__shield" aria-label="Planner predicate">
                <code>{`inject_filter(workspace_id = 'ws_101')`}</code>
              </div>
            )}
          </article>
        ))
      }

      {rest.map((cap) => (
        <article class="landing-cap landing-cap--small">
          <span class="landing-cap__eyebrow">{cap.eyebrow}</span>
          <h3 class="landing-cap__title">{cap.title}</h3>
          <p class="landing-cap__body">{cap.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
