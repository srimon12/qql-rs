---
import { APPS, SITE, SOCIAL } from "../config/site";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Documentation", href: "/docs/" },
      { label: "Playground", href: "/playground/" },
      { label: "Language reference", href: "/docs/language/" },
      { label: "Edge runtime", href: "/docs/edge/getting-started/" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Quickstart", href: "/docs/getting-started/quickstart/" },
      { label: "Installation", href: "/docs/getting-started/installation/" },
      { label: "VS Code extension", href: "/docs/tools/editors/" },
      { label: "Releases", href: `${APPS.github.url}/releases`, external: true },
    ],
  },
  {
    title: "Connect",
    links: [
      { label: "GitHub", href: APPS.github.url, external: true },
      { label: "X / Twitter", href: SOCIAL.twitter, external: true },
      { label: "Email", href: `mailto:${SITE.email}` },
      { label: "Veristamp", href: "https://veristamp.in", external: true },
    ],
  },
] as const;
---

<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <a class="brand" href="/" aria-label="QQL home">
        <span class="brand__mark" aria-hidden="true">
          <img src={`${import.meta.env.BASE_URL}logo.svg`.replace(/([^:]\/)\/+/g, "$1")} alt="" width="32" height="32" />
        </span>
        <span class="brand__name">QQL</span>
      </a>
      <p class="site-footer__blurb">
        A typed, declarative query language for Qdrant. One surface for
        search, hybrid retrieval, mutations, and schema across every runtime.
      </p>
      <span class="site-footer__pill">MIT licensed</span>
    </div>

    {columns.map((col) => (
      <nav class="site-footer__col" aria-label={`${col.title} links`}>
        <p class="site-footer__col-title">{col.title}</p>
        <ul>
          {col.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={"external" in link && link.external ? "_blank" : undefined}
                rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} {SITE.org}. QQL is MIT licensed.</span>
    <span class="site-footer__tag">Same parser, every runtime.</span>
  </div>
</footer>
