---
import { readdirSync, readFileSync } from "node:fs";
import { basename, join } from "node:path";
import { fileURLToPath } from "node:url";
import EditorPanel from "../../components/playground/EditorPanel.astro";
import ExportDialog from "../../components/playground/ExportDialog.astro";
import InspectorPanel from "../../components/playground/InspectorPanel.astro";
import PolicyDialog from "../../components/playground/PolicyDialog.astro";
import PresetDialog from "../../components/playground/PresetDialog.astro";
import SettingsDialog from "../../components/playground/SettingsDialog.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { ANALYTICS, APPS } from "../../config/site";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../../styles/global.css";

const workspaceRoot = fileURLToPath(new URL("../../../../", import.meta.url));
const fixtureRoot = join(workspaceRoot, "language", "v1", "fixtures");
const validRoot = join(fixtureRoot, "valid");
const expectedRoot = join(fixtureRoot, "expected");

const categoryFor = (id: string) => {
	if (id.startsWith("query-")) return "Query";
	if (id.includes("collection") || id.includes("index") || id.includes("shard"))
		return "Schema";
	if (
		id.startsWith("upsert") ||
		id.startsWith("update") ||
		id.startsWith("delete") ||
		id.startsWith("clear")
	)
		return "Data";
	if (id === "filters") return "Filters";
	if (id === "scripts" || id === "string-delimiters") return "Language";
	return "Operations";
};

const presets = readdirSync(validRoot)
	.filter((name) => name.endsWith(".qql"))
	.sort()
	.map((name) => {
		const id = basename(name, ".qql");
		const query = readFileSync(join(validRoot, name), "utf8").trim();
		const comments = query
			.split("\n")
			.filter((line) => line.startsWith("--"))
			.map((line) => line.replace(/^--\s*/, "").trim())
			.filter(Boolean);
		const expected = JSON.parse(
			readFileSync(join(expectedRoot, `${id}.json`), "utf8"),
		) as { statements?: unknown[] };
		const label = (comments[0]?.split("—")[1] ?? id)
			.trim()
			.replace(/\bqql$/i, "");
		const description =
			comments
				.find((line) => line.startsWith("Tests:"))
				?.replace("Tests:", "")
				.trim() ??
			comments[1] ??
			"Valid QQL v1 conformance fixture.";

		return {
			id,
			label,
			description,
			category: categoryFor(id),
			query,
			statements: expected.statements?.length ?? 1,
		};
	});

const categories = [
	...new Set(presets.map((preset) => preset.category)),
].sort();
// Small canned landing query with explicit vectors: it analyzes offline with
// zero config, needs no embedder, and needs no localhost Qdrant.
const verifiedQqlDefault = String.raw`QUERY [0.1, 0.2, 0.3] FROM docs LIMIT 5;`;
const landingQuery = verifiedQqlDefault;
const landingLabel = "Quick demo";
const pageTitle = "QQL Playground: parse, plan, and run Qdrant queries";
const pageDescription =
	"Explore the current qql-rs parser and planner in your browser using the complete QQL v1 valid fixture corpus.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="QQL playground, Qdrant query builder, interactive vector search, AST visualizer, WASM planner, QQL online"
    />
    <link rel="canonical" href={`${APPS.playground.url}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.playground.url}/`} />
    <meta property="og:image" content={`${APPS.home.url}/open-graph/playground.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@srimon_12" />
    <meta name="twitter:creator" content="@srimon_12" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${APPS.home.url}/open-graph/playground.png`} />
    <script is:inline>
      (() => {
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "QQL Playground",
        url: APPS.playground.url,
        description: pageDescription,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Web Browser / WebAssembly",
        browserRequirements: "Requires WebAssembly support",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
      })}
    />
  </head>
  <body class="app-shell min-h-dvh bg-[var(--sl-color-bg)] font-(family-name:--sl-font) text-[var(--sl-color-gray-1)]">
    <SiteHeader active="playground" />
    <main
      id="main-content"
      class="flex h-[calc(100dvh-4rem)] min-h-0 flex-col overflow-hidden"
    >
      <h1 class="sr-only">QQL Playground</h1>

      {/* ── Toolbar: four controls, bench chrome (44px) ── */}
      <div
        class="flex h-11 min-w-0 shrink-0 items-center gap-1 border-b border-[var(--sl-color-gray-5)] px-2 sm:gap-1.5 sm:px-3"
        role="toolbar"
        aria-label="Playground toolbar"
      >
        <span
          class="app-chip app-chip--status min-w-0 max-sm:shrink-0 sm:flex-initial"
          data-mode-offline
          data-mode-connected
          role="status"
          aria-live="polite"
          title="Parsing and planning run in this browser. Execution needs a reachable Qdrant."
        >
          <span
            class="size-1.5 shrink-0 rounded-full bg-[var(--sl-color-gray-4)] transition-colors"
            data-runtime-dot
            aria-hidden="true"></span>
          <span class="app-chip__short app-chip__short--loading" aria-hidden="true">WASM loading</span>
          <span class="app-chip__short app-chip__short--ready" aria-hidden="true">WASM ready</span>
          <span class="app-chip__short app-chip__short--failed" aria-hidden="true">WASM failed</span>
          <span class="min-w-0 truncate max-sm:sr-only" data-runtime-status dir="rtl">Loading current WASM…</span>
          <span class="hidden shrink-0 text-[var(--sl-color-gray-5)] sm:inline" aria-hidden="true">·</span>
          <span
            class="size-1.5 shrink-0 rounded-full bg-[var(--sl-color-gray-4)] transition-colors"
            data-connected-dot
            aria-hidden="true"></span>
          <span class="min-w-0 truncate max-sm:sr-only" data-connected-label>Connected: not checked</span>
          <span class="app-chip__fallback min-w-0 truncate">No Qdrant: offline analysis still works</span>
        </span>

        <button
          class="app-chip min-w-0 max-w-[7rem] sm:max-w-[16rem]"
          type="button"
          data-open-presets
          title="Load a conformance fixture"
        >
          <span class="app-chip__label hidden sm:inline">Example</span>
          <span class="app-chip__value" data-active-fixture>{landingLabel}</span>
          <span class="app-chip__caret" aria-hidden="true">▾</span>
        </button>

        <button
          class="app-chip min-w-0 max-w-[8.75rem] sm:max-w-none"
          type="button"
          data-open-settings
          title="Edit the Qdrant URL and embeddings"
        >
          <span class="app-chip__label hidden sm:inline">Connection</span>
          <span class="app-chip__value" data-connection-value>localhost:6333 · MiniLM</span>
          <span class="app-chip__caret" aria-hidden="true">▾</span>
        </button>

        <a
          class="app-chip ml-auto shrink-0 px-2"
          href="/docs/"
          data-docs-backlink
          hidden
          title="Back to the docs page that opened this query"
        >
          <span class="hidden sm:inline">Docs</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {/* ── Work area: editor | 8px divider | inspector ── */}
      <div class="min-h-0 min-w-0 flex-1 p-2">
        <div
          class="grid h-full min-h-0 grid-cols-1 grid-rows-[minmax(0,3fr)_minmax(0,2fr)] overflow-hidden rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] lg:grid-cols-[var(--split-a,1.08fr)_0.5rem_var(--split-b,0.92fr)] lg:grid-rows-[minmax(0,1fr)]"
          data-default-query={landingQuery}
          data-workspace
        >
          <EditorPanel />
          <div
            aria-label="Resize editor and inspector panels"
            aria-orientation="vertical"
            class="relative hidden min-w-0 cursor-col-resize select-none lg:block"
            role="separator"
            tabindex="0"
            title="Drag to resize (double-click to reset)"
            data-split-handle
          >
            <span class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[var(--sl-color-gray-5)] transition-colors" aria-hidden="true"></span>
          </div>
          <InspectorPanel />
        </div>
      </div>

      {/* ── Status bar: 28px, telemetry first, current detail second ── */}
      <div
        class="app-statusbar flex h-7 min-w-0 shrink-0 items-center gap-x-4 overflow-hidden border-t border-[var(--sl-color-gray-5)] px-3 font-mono text-[0.6875rem] text-[var(--sl-color-gray-3)]"
        data-status-panel
        role="status"
        aria-live="polite"
        aria-label="Backend status"
      >
        <span class="flex min-w-0 items-center gap-x-3 lg:shrink-0">
          <span class="min-w-0 truncate">
            <span class="hidden md:inline">endpoint </span>
            <strong class="font-medium text-[var(--sl-color-gray-1)]" data-status-endpoint>Not checked yet</strong>
          </span>
          <span class="hidden min-w-0 truncate sm:inline">
            <span class="hidden md:inline">embeddings </span>
            <strong class="font-medium text-[var(--sl-color-gray-1)]" data-status-embed>MiniLM (browser)</strong>
          </span>
          <span class="min-w-0 truncate">
            <span class="hidden md:inline">engine </span>
            <strong class="font-medium text-[var(--sl-color-gray-1)]" data-status-wasm>Loading WASM</strong>
          </span>
        </span>
        <span class="hidden min-w-0 flex-1 truncate sm:block" data-status-detail hidden></span>
      </div>
    </main>

    <PresetDialog presets={presets} categories={categories} />
    <SettingsDialog />
    <PolicyDialog />
    <ExportDialog />
    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>
    <SiteFooter />

    <script>
      import "../../scripts/playground";
    </script>
  </body>
</html>
