---
import { readdirSync, readFileSync } from "node:fs";
import { basename, join } from "node:path";
import { fileURLToPath } from "node:url";
import EditorPanel from "../../components/playground/EditorPanel.astro";
import ExportDialog from "../../components/playground/ExportDialog.astro";
import InspectorPanel from "../../components/playground/InspectorPanel.astro";
import PolicyDialog from "../../components/playground/PolicyDialog.astro";
import PresetDialog from "../../components/playground/PresetDialog.astro";
import SettingsDialog from "../../components/playground/SettingsDialog.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { ANALYTICS, APPS } from "../../config/site";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../../styles/global.css";

const workspaceRoot = fileURLToPath(new URL("../../../../", import.meta.url));
const fixtureRoot = join(workspaceRoot, "language", "v1", "fixtures");
const validRoot = join(fixtureRoot, "valid");
const expectedRoot = join(fixtureRoot, "expected");

const categoryFor = (id: string) => {
	if (id.startsWith("query-")) return "Query";
	if (id.includes("collection") || id.includes("index") || id.includes("shard"))
		return "Schema";
	if (
		id.startsWith("upsert") ||
		id.startsWith("update") ||
		id.startsWith("delete") ||
		id.startsWith("clear")
	)
		return "Data";
	if (id === "filters") return "Filters";
	if (id === "scripts" || id === "string-delimiters") return "Language";
	return "Operations";
};

const presets = readdirSync(validRoot)
	.filter((name) => name.endsWith(".qql"))
	.sort()
	.map((name) => {
		const id = basename(name, ".qql");
		const query = readFileSync(join(validRoot, name), "utf8").trim();
		const comments = query
			.split("\n")
			.filter((line) => line.startsWith("--"))
			.map((line) => line.replace(/^--\s*/, "").trim())
			.filter(Boolean);
		const expected = JSON.parse(
			readFileSync(join(expectedRoot, `${id}.json`), "utf8"),
		) as { statements?: unknown[] };
		const label = (comments[0]?.split("—")[1] ?? id)
			.trim()
			.replace(/\bqql$/i, "");
		const description =
			comments
				.find((line) => line.startsWith("Tests:"))
				?.replace("Tests:", "")
				.trim() ??
			comments[1] ??
			"Valid QQL v1 conformance fixture.";

		return {
			id,
			label,
			description,
			category: categoryFor(id),
			query,
			preview:
				query
					.split("\n")
					.map((line) => line.trim())
					.find((line) => line && !line.startsWith("--")) ?? "",
			statements: expected.statements?.length ?? 1,
		};
	});

const categories = [
	...new Set(presets.map((preset) => preset.category)),
].sort();
// First Run targets a real live collection (explicit USING, no guessing):
// the browser/HTTP embedder resolves the TEXT query, Qdrant must be up.
const verifiedQqlDefault = String.raw`QUERY 'cozy apartment near Mitte' FROM geosmart_berlin_stays USING dense AS DENSE LIMIT 5;`;
const landingQuery = verifiedQqlDefault;
const landingLabel = "Quick demo";
const pageTitle = "QQL Playground: parse, plan, and run Qdrant queries";
const pageDescription =
	"Explore the current qql-rs parser and planner in your browser using the complete QQL v1 valid fixture corpus.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="QQL playground, Qdrant query builder, interactive vector search, AST visualizer, WASM planner, QQL online"
    />
    <link rel="canonical" href={`${APPS.playground.url}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.playground.url}/`} />
    <meta property="og:image" content={`${APPS.home.url}/open-graph/playground.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@srimon_12" />
    <meta name="twitter:creator" content="@srimon_12" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${APPS.home.url}/open-graph/playground.png`} />
    <script is:inline>
      (() => {
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "QQL Playground",
        url: APPS.playground.url,
        description: pageDescription,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Web Browser / WebAssembly",
        browserRequirements: "Requires WebAssembly support",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
      })}
    />
  </head>
  <body class="app-shell min-h-dvh bg-[var(--sl-color-bg)] font-(family-name:--sl-font) text-[var(--sl-color-gray-1)]">
    <SiteHeader active="playground" />
    <main
      id="main-content"
      class="flex h-[calc(100dvh-4rem)] min-h-0 flex-col overflow-hidden"
    >
      <h1 class="sr-only">QQL Playground</h1>

      {/* ── EnvBar 40px: environment truth only — connection · engine · embeddings ── */}
      <div
        class="flex h-10 min-w-0 shrink-0 items-center gap-3 overflow-hidden border-b border-[var(--sl-color-gray-5)] px-3 font-mono text-[0.6875rem] whitespace-nowrap text-[var(--sl-color-gray-3)]"
        data-status-panel
        role="status"
        aria-live="polite"
        aria-label="Backend status"
      >
        <span class="flex min-w-0 items-center gap-1.5">
          <span
            class="size-1.5 shrink-0 rounded-full bg-[var(--sl-color-gray-4)] transition-colors"
            data-connected-dot
            aria-hidden="true"></span>
          <span class="hidden md:inline">endpoint </span>
          <strong class="max-w-[220px] truncate font-medium text-[var(--sl-color-gray-1)]" data-status-endpoint>Not checked yet</strong>
        </span>
        <span class="flex shrink-0 items-center gap-1.5">
          <span
            class="size-1.5 shrink-0 rounded-full bg-[var(--sl-color-gray-4)] transition-colors"
            data-runtime-dot
            aria-hidden="true"></span>
          <strong class="hidden font-medium text-[var(--sl-color-gray-1)] sm:inline" data-status-wasm>Loading WASM</strong>
        </span>
        <span class="app-chip hidden min-w-0 sm:inline-flex" title="Embedding provider">
          <span class="app-chip__label">Embed</span>
          <strong class="app-chip__value max-w-44 truncate font-medium" data-status-embed>MiniLM (browser)</strong>
          <strong
            class="ml-1 shrink-0 rounded-full border border-[var(--sl-color-gray-5)] px-1.5 py-px font-medium"
            data-embed-dim-chip
            hidden></strong>
        </span>
        <button
          class="app-action shrink-0 px-1.5 sm:hidden"
          type="button"
          data-open-settings
          aria-label="Connection settings"
          title="Connection settings"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg>
        </button>
        <span class="sr-only" data-runtime-status>Loading current WASM…</span>
        <a
          class="app-action ml-auto hidden shrink-0 px-1.5 sm:inline-flex"
          href="/docs/"
          data-docs-backlink
          hidden
          title="Back to the docs page that opened this query"
        >
          Docs <span aria-hidden="true">→</span>
        </a>
      </div>

      {/* ── Work area: editor | 8px divider | inspector ── */}
      <div class="min-h-0 min-w-0 flex-1 p-2">
        <div
          class="grid h-full min-h-0 grid-cols-1 grid-rows-[minmax(0,3fr)_minmax(0,2fr)] overflow-hidden rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] lg:grid-cols-[var(--split-a,1.08fr)_0.5rem_var(--split-b,0.92fr)] lg:grid-rows-[minmax(0,1fr)]"
          data-default-query={landingQuery}
          data-workspace
        >
          <EditorPanel exampleLabel={landingLabel} />
          <div
            aria-label="Resize editor and inspector panels"
            aria-orientation="vertical"
            class="relative hidden min-w-0 cursor-col-resize select-none lg:block"
            role="separator"
            tabindex="0"
            title="Drag to resize (double-click to reset)"
            data-split-handle
          >
            <span class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[var(--sl-color-gray-5)] transition-colors" aria-hidden="true"></span>
          </div>
          <InspectorPanel />
        </div>
      </div>
    </main>

    <PresetDialog presets={presets} categories={categories} />
    <SettingsDialog />
    <PolicyDialog />
    <ExportDialog />
    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>
    <SiteFooter />

    <script>
      import "../../lib/playground/playground";
    </script>
  </body>
</html>
