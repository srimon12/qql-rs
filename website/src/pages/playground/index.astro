---
import { readdirSync, readFileSync } from "node:fs";
import { basename, join } from "node:path";
import { fileURLToPath } from "node:url";
import EditorPanel from "../../components/playground/EditorPanel.astro";
import ExportDialog from "../../components/playground/ExportDialog.astro";
import InspectorPanel from "../../components/playground/InspectorPanel.astro";
import PolicyDialog from "../../components/playground/PolicyDialog.astro";
import PresetDialog from "../../components/playground/PresetDialog.astro";
import SettingsDialog from "../../components/playground/SettingsDialog.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { ANALYTICS, APPS } from "../../config/site";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../../styles/global.css";

const workspaceRoot = fileURLToPath(new URL("../../../../", import.meta.url));
const fixtureRoot = join(workspaceRoot, "language", "v1", "fixtures");
const validRoot = join(fixtureRoot, "valid");
const expectedRoot = join(fixtureRoot, "expected");

const categoryFor = (id: string) => {
	if (id.startsWith("query-")) return "Query";
	if (id.includes("collection") || id.includes("index") || id.includes("shard"))
		return "Schema";
	if (
		id.startsWith("upsert") ||
		id.startsWith("update") ||
		id.startsWith("delete") ||
		id.startsWith("clear")
	)
		return "Data";
	if (id === "filters") return "Filters";
	if (id === "scripts" || id === "string-delimiters") return "Language";
	return "Operations";
};

const presets = readdirSync(validRoot)
	.filter((name) => name.endsWith(".qql"))
	.sort()
	.map((name) => {
		const id = basename(name, ".qql");
		const query = readFileSync(join(validRoot, name), "utf8").trim();
		const comments = query
			.split("\n")
			.filter((line) => line.startsWith("--"))
			.map((line) => line.replace(/^--\s*/, "").trim())
			.filter(Boolean);
		const expected = JSON.parse(
			readFileSync(join(expectedRoot, `${id}.json`), "utf8"),
		) as { statements?: unknown[] };
		const label = (comments[0]?.split("—")[1] ?? id)
			.trim()
			.replace(/\bqql$/i, "");
		const description =
			comments
				.find((line) => line.startsWith("Tests:"))
				?.replace("Tests:", "")
				.trim() ??
			comments[1] ??
			"Valid QQL v1 conformance fixture.";

		return {
			id,
			label,
			description,
			category: categoryFor(id),
			query,
			preview:
				query
					.split("\n")
					.map((line) => line.trim())
					.find((line) => line && !line.startsWith("--")) ?? "",
			statements: expected.statements?.length ?? 1,
		};
	});

const categories = [
	...new Set(presets.map((preset) => preset.category)),
].sort();
// First Run targets a real live collection (explicit USING, no guessing):
// the browser/HTTP embedder resolves the TEXT query, Qdrant must be up.
const verifiedQqlDefault = String.raw`QUERY 'cozy apartment near Mitte' FROM geosmart_berlin_stays USING dense AS DENSE LIMIT 5;`;
const landingQuery = verifiedQqlDefault;
const landingLabel = "Quick demo";
const pageTitle = "QQL Playground: parse, plan, and run Qdrant queries";
const pageDescription =
	"Explore the current qql-rs parser and planner in your browser using the complete QQL v1 valid fixture corpus.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="QQL playground, Qdrant query builder, interactive vector search, AST visualizer, WASM planner, QQL online"
    />
    <link rel="canonical" href={`${APPS.playground.url}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.playground.url}/`} />
    <meta property="og:image" content={`${APPS.home.url}/open-graph/playground.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@srimon_12" />
    <meta name="twitter:creator" content="@srimon_12" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${APPS.home.url}/open-graph/playground.png`} />
    <script is:inline>
      (() => {
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "QQL Playground",
        url: APPS.playground.url,
        description: pageDescription,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Web Browser / WebAssembly",
        browserRequirements: "Requires WebAssembly support",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
      })}
    />
  </head>
  <body class="app-shell min-h-dvh bg-[var(--sl-color-bg)] font-(family-name:--sl-font) text-[var(--sl-color-gray-1)]">
    <SiteHeader active="playground" />
    <main
      id="main-content"
      class="flex h-[calc(100dvh-4rem)] min-h-0 flex-col overflow-hidden"
    >
      <h1 class="sr-only">QQL Playground</h1>

      {/* ── Setup & Environment Header ── */}
      <header
        class="flex min-h-11 shrink-0 items-center justify-between gap-3 border-b border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg)] px-3.5 py-1.5 font-mono text-xs"
        data-status-panel
        role="status"
        aria-live="polite"
        aria-label="Backend status"
      >
        <!-- Left: Status indicators -->
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <!-- Database endpoint status pill -->
          <span class="inline-flex min-w-0 items-center gap-2 rounded-full border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-2.5 py-1 text-[0.72rem] text-[var(--sl-color-gray-2)]">
            <span
              class="size-2 shrink-0 rounded-full bg-[var(--sl-color-gray-4)] transition-colors"
              data-connected-dot
              aria-hidden="true"
            ></span>
            <span class="text-[var(--sl-color-gray-3)]">Qdrant:</span>
            <strong class="max-w-[200px] truncate font-semibold text-[var(--sl-color-white)]" data-status-endpoint>
              Not checked yet
            </strong>
          </span>

          <!-- WASM engine status pill -->
          <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-2.5 py-1 text-[0.72rem] text-[var(--sl-color-gray-2)]">
            <span
              class="size-1.5 shrink-0 rounded-full bg-[var(--sl-color-gray-4)] transition-colors"
              data-runtime-dot
              aria-hidden="true"
            ></span>
            <strong class="font-medium text-[var(--sl-color-gray-1)]" data-status-wasm>
              Loading WASM
            </strong>
          </span>

          <!-- Embeddings status pill -->
          <span class="hidden md:inline-flex items-center gap-1.5 rounded-full border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] px-2.5 py-1 text-[0.72rem] text-[var(--sl-color-gray-2)]" title="Active embedding resolver">
            <span class="text-[var(--sl-color-accent-high)] font-bold">✦</span>
            <span class="text-[var(--sl-color-gray-3)]">Embed:</span>
            <strong class="max-w-40 truncate font-medium text-[var(--sl-color-white)]" data-status-embed>
              MiniLM (browser)
            </strong>
            <span
              class="rounded bg-[var(--sl-color-gray-7)] px-1 font-mono text-[0.625rem] text-[var(--sl-color-gray-3)]"
              data-embed-dim-chip
              hidden
            ></span>
          </span>
        </div>

        <!-- Right: Actions -->
        <div class="flex shrink-0 items-center gap-2">
          <!-- Unified Database & Embeddings Configuration trigger -->
          <button
            class="app-action h-7.5 px-3 text-xs font-medium gap-1.5 border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] hover:border-[var(--sl-color-gray-4)] hover:bg-[var(--sl-color-gray-7)] text-[var(--sl-color-gray-1)] rounded-md shadow-2xs transition-colors"
            type="button"
            data-open-settings
            aria-label="Configure Database and Embeddings"
            title="Configure Database and Embeddings"
          >
            <svg class="size-3.5 text-[var(--sl-color-gray-3)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            <span class="font-medium">DB &amp; Embeddings</span>
          </button>

          <span class="sr-only" data-runtime-status>Loading current WASM…</span>
          <a
            class="app-action h-7.5 px-2 text-xs text-[var(--sl-color-gray-3)] hover:text-[var(--sl-color-gray-1)] hidden sm:inline-flex"
            href="/docs/"
            data-docs-backlink
            hidden
            title="Back to docs"
          >
            Docs <span aria-hidden="true">→</span>
          </a>
        </div>
      </header>

      {/* ── Work area: editor | 8px divider | inspector ── */}
      <div class="min-h-0 min-w-0 flex-1 p-2">
        <div
          class="grid h-full min-h-0 grid-cols-1 grid-rows-[minmax(0,3fr)_minmax(0,2fr)] overflow-hidden rounded-lg border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] lg:grid-cols-[var(--split-a,1.08fr)_0.5rem_var(--split-b,0.92fr)] lg:grid-rows-[minmax(0,1fr)]"
          data-default-query={landingQuery}
          data-workspace
        >
          <EditorPanel exampleLabel={landingLabel} />
          <div
            aria-label="Resize editor and inspector panels"
            aria-orientation="vertical"
            class="relative hidden min-w-0 cursor-col-resize select-none lg:block"
            role="separator"
            tabindex="0"
            title="Drag to resize (double-click to reset)"
            data-split-handle
          >
            <span class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[var(--sl-color-gray-5)] transition-colors" aria-hidden="true"></span>
          </div>
          <InspectorPanel />
        </div>
      </div>
    </main>

    <PresetDialog presets={presets} categories={categories} />
    <SettingsDialog />
    <PolicyDialog />
    <ExportDialog />
    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>
    <SiteFooter />

    <script>
      import "../../lib/playground/playground";
    </script>
  </body>
</html>
