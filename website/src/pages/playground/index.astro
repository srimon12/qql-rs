---
import { readFileSync, readdirSync } from "node:fs";
import { basename, join } from "node:path";
import { fileURLToPath } from "node:url";
import ExportDialog from "../../components/playground/ExportDialog.astro";
import EditorPanel from "../../components/playground/EditorPanel.astro";
import InspectorPanel from "../../components/playground/InspectorPanel.astro";
import PolicyDialog from "../../components/playground/PolicyDialog.astro";
import PresetDialog from "../../components/playground/PresetDialog.astro";
import SettingsDialog from "../../components/playground/SettingsDialog.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { ANALYTICS, APPS } from "../../config/site";
import "../../styles/global.css";

const workspaceRoot = fileURLToPath(
  new URL("../../../../", import.meta.url),
);
const fixtureRoot = join(workspaceRoot, "language", "v1", "fixtures");
const validRoot = join(fixtureRoot, "valid");
const expectedRoot = join(fixtureRoot, "expected");

const categoryFor = (id: string) => {
  if (id.startsWith("query-")) return "Query";
  if (id.includes("collection") || id.includes("index") || id.includes("shard")) return "Schema";
  if (
    id.startsWith("upsert") ||
    id.startsWith("update") ||
    id.startsWith("delete") ||
    id.startsWith("clear")
  ) return "Data";
  if (id === "filters") return "Filters";
  if (id === "scripts" || id === "string-delimiters") return "Language";
  return "Operations";
};

const presets = readdirSync(validRoot)
  .filter((name) => name.endsWith(".qql"))
  .sort()
  .map((name) => {
    const id = basename(name, ".qql");
    const query = readFileSync(join(validRoot, name), "utf8").trim();
    const comments = query
      .split("\n")
      .filter((line) => line.startsWith("--"))
      .map((line) => line.replace(/^--\s*/, "").trim())
      .filter(Boolean);
    const expected = JSON.parse(
      readFileSync(join(expectedRoot, `${id}.json`), "utf8"),
    ) as { statements?: unknown[] };
    const label = (comments[0]?.split("—")[1] ?? id)
      .trim()
      .replace(/\bqql$/i, "");
    const description =
      comments.find((line) => line.startsWith("Tests:"))?.replace("Tests:", "").trim() ??
      comments[1] ??
      "Valid QQL v1 conformance fixture.";

    return {
      id,
      label,
      description,
      category: categoryFor(id),
      query,
      statements: expected.statements?.length ?? 1,
    };
  });

const categories = [...new Set(presets.map((preset) => preset.category))].sort();
const defaultPreset =
  presets.find((preset) => preset.id === "query-hybrid") ?? presets[0];
const pageTitle = "QQL Playground — Parse, plan, and run Qdrant queries";
const pageDescription =
  "Explore the current qql-rs parser and planner in your browser using the complete QQL v1 valid fixture corpus.";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={`${APPS.playground.url}/`} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.playground.url}/`} />
    <meta property="og:image" content={`${APPS.home.url}/og-image.png`} />
    <script is:inline>
      (() => {
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
  </head>
  <body class="min-h-dvh bg-[var(--sl-color-bg)] font-[var(--sl-font)] text-[var(--sl-color-gray-1)]">
    <SiteHeader active="playground" />
    <main id="main-content" class="mx-auto flex w-full max-w-[96rem] flex-col gap-3 px-3 py-3 sm:px-5 sm:py-5">
      <h1 class="sr-only">QQL Playground</h1>
      <div class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-1 border-b border-[var(--sl-color-gray-5)] px-1 pb-3 font-mono text-[0.68rem] text-[var(--sl-color-gray-3)]" role="status" aria-live="polite">
        <span class="inline-flex items-center gap-2 text-[var(--sl-color-gray-2)]"><span class="size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0.5rem_#31b276]"></span><span data-runtime-status>Loading current WASM…</span></span>
        <span class="hidden text-[var(--sl-color-gray-4)] sm:inline">/</span>
        <span data-active-fixture>{defaultPreset.label}</span>
        <span class="ml-auto hidden truncate sm:inline" data-connection-summary>http://localhost:6333 · browser MiniLM</span>
        <a class="font-medium text-[var(--sl-color-accent-high)] no-underline hover:text-[var(--sl-color-white)] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sl-color-accent)]" href="/docs/" data-docs-backlink hidden>← Back to documentation</a>
      </div>

      <div class="grid min-h-[calc(100dvh-8.75rem)] grid-cols-1 overflow-hidden rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-gray-6)] shadow-[0_1.5rem_5rem_color-mix(in_srgb,black_18%,transparent)] lg:grid-cols-[minmax(0,1.08fr)_minmax(26rem,0.92fr)]" data-default-query={defaultPreset.query}>
        <EditorPanel />
        <InspectorPanel />
      </div>
    </main>

    <PresetDialog presets={presets} categories={categories} />
    <SettingsDialog />
    <PolicyDialog />
    <ExportDialog />
    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>
    <SiteFooter />

    <script>
      import "../../scripts/playground";
    </script>
  </body>
</html>
