---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/newsreader/latin-300.css";
import "@fontsource/newsreader/latin-400.css";
import "../styles/global.css";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/landing/CtaBand.astro";
import InstallGrid from "../components/landing/InstallGrid.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import LanguageSamples from "../components/landing/LanguageSamples.astro";
import PipelineSteps from "../components/landing/PipelineSteps.astro";
import ProblemCompare from "../components/landing/ProblemCompare.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { ANALYTICS, APPS, SITE, SOCIAL } from "../config/site";
import {
	cta,
	faq,
	getStarted,
	hero,
	language,
	pipeline,
	problem,
	stats,
} from "../data/landing";

const pageTitle = "QQL: SQL for Qdrant vector search";
const pageDescription =
	"QQL is to Qdrant what SQL is to Postgres — one declarative language for hybrid search, filters, and mutations across Rust, Python, Node.js, WASM, and edge.";

// The documentation verifier parses every `verifiedQql` String.raw template
// (see scripts/verify-qql-docs.mjs), so the marker must stay despite none of
// the templates containing backslashes.
const verifiedQqlHero = String.raw`QUERY 'chest pain' FROM medical
USING dense
WHERE department = 'cardio'
SHARD 'hospital-east'
LIMIT 5;`;

const verifiedQqlCompareHybrid = String.raw`QUERY 'distributed consensus' FROM docs
USING HYBRID
  DENSE dense_vec
  SPARSE bm25_vec
  FUSION RRF
WHERE status = 'active'
LIMIT 10;`;

const verifiedQqlCompareTenant = String.raw`QUERY 'annual financial risks' FROM filings
WHERE department = 'finance'
SHARD 'tenant-corp-99'
LIMIT 5;`;

const verifiedQqlCompareFilters = String.raw`QUERY 'industrial robotics' FROM products
WHERE (category = 'hardware' OR category = 'tools')
  AND price <= 1200.0 AND in_stock = true
LIMIT 20;`;

const verifiedQqlHybrid = String.raw`QUERY TEXT 'vector database' FROM docs
  USING HYBRID DENSE dense SPARSE bm25 FUSION RRF
  LIMIT 10;`;

const verifiedQqlFacet = String.raw`FACET room_type FROM stays WHERE price < 150 LIMIT 5 EXACT true;`;

const verifiedQqlFormula = String.raw`QUERY FORMULA MAX(MIN(score * 2.0, 10.0), 0.0) + ACOSH(popularity + 1.0) [DEFAULT = 0.0]
  DEFAULTS (score = 0.0, popularity = 0)
FROM papers LIMIT 10;`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large"
    />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f4ed" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141413" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={`${APPS.home.url}/`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.home.url}/`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="QQL" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${APPS.home.url}/open-graph/home.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="QQL — SQL for Qdrant vector search" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@srimon_12" />
    <meta name="twitter:creator" content="@srimon_12" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${APPS.home.url}/open-graph/home.png`} />
    <meta name="twitter:image:alt" content="QQL — SQL for Qdrant vector search" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "QQL",
        url: `${APPS.home.url}/`,
        version: "0.4.0",
        operatingSystem: "Linux, macOS, Windows, Web",
        applicationCategory: "DeveloperApplication",
        description: pageDescription,
        codeRepository: APPS.github.url,
        installUrl: APPS.github.url,
        license: "https://opensource.org/license/mit",
        featureList: [
          "Hybrid search with RRF fusion",
          "Declarative filtering and mutations",
          "Multitenancy via filter injection and shard routing",
          "In-browser WASM parser",
        ],
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        publisher: {
          "@type": "Organization",
          name: SITE.org,
          url: "https://veristamp.in",
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": `${APPS.home.url}/#website`,
        name: "QQL",
        url: APPS.home.url,
        inLanguage: "en",
        description: pageDescription,
        sameAs: [SOCIAL.github, SOCIAL.twitter],
        publisher: {
          "@type": "Organization",
          name: SITE.org,
          url: "https://veristamp.in",
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.items.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      })}
    />
  </head>

  <body class="landing-body overflow-x-clip">
    <div class="grain" aria-hidden="true"></div>
    <SiteHeader active="home" />

    <main id="main-content" class="relative z-[1]">
      <LandingHero
        headline={hero.headline}
        lede={hero.lede}
        eyebrow={hero.eyebrow}
        primaryCta={hero.primaryCta}
        secondaryCta={hero.secondaryCta}
        specimenTitle={hero.specimenTitle}
        specimenMeta={hero.specimenMeta}
        specimenRoute={hero.specimenRoute}
        specimenStatus={hero.specimenStatus}
        specimenQql={verifiedQqlHero}
        stats={stats}
      />

      <ProblemCompare
        heading={problem.heading}
        sub={problem.sub}
        guideHref={problem.guideHref}
        guideLabel={problem.guideLabel}
        hybridQql={verifiedQqlCompareHybrid}
        tenantQql={verifiedQqlCompareTenant}
        filtersQql={verifiedQqlCompareFilters}
      />

      <PipelineSteps
        heading={pipeline.heading}
        sub={pipeline.sub}
        steps={pipeline.steps}
      />

      <LanguageSamples
        heading={language.heading}
        sub={language.sub}
        footHref={language.footHref}
        footLabel={language.footLabel}
        hybridQql={verifiedQqlHybrid}
        facetQql={verifiedQqlFacet}
        formulaQql={verifiedQqlFormula}
      />

      <InstallGrid
        heading={getStarted.heading}
        sub={getStarted.sub}
        installs={getStarted.installs}
        footHref={getStarted.footHref}
        footLabel={getStarted.footLabel}
      />

      <section class="border-t border-[var(--sl-color-gray-5)] py-[clamp(3rem,6vw,4.5rem)]" aria-labelledby="faq-heading">
        <div class="shell">
          <header class="max-w-[44rem] reveal">
            <h2 id="faq-heading" class="h-section m-0">{faq.heading}</h2>
          </header>
          <div class="reveal">
            <FaqList />
          </div>
        </div>
      </section>

      <CtaBand
        heading={cta.heading}
        body={cta.body}
        eyebrow={cta.eyebrow}
        primaryCta={cta.primaryCta}
        secondaryCta={cta.secondaryCta}
      />
    </main>

    <SiteFooter />

    <script>
      const initReveal = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.05, rootMargin: "0px 0px 50px 0px" },
        );
        document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initReveal);
      } else {
        initReveal();
      }
    </script>
  </body>
</html>
