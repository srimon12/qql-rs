---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/newsreader/latin-300.css";
import "@fontsource/newsreader/latin-400.css";
import "../styles/global.css";
import "@qql/ui-docs/chrome.css";
import "@qql/ui-docs/landing.css";
import CtaBand from "../components/landing/CtaBand.astro";
import FaqList from "../components/landing/FaqList.astro";
import InstallGrid from "../components/landing/InstallGrid.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import LanguageSamples from "../components/landing/LanguageSamples.astro";
import PipelineSteps from "../components/landing/PipelineSteps.astro";
import ProblemCompare from "../components/landing/ProblemCompare.astro";
import StatsStrip from "../components/landing/StatsStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { ANALYTICS, APPS, SITE } from "../config/site";
import {
	cta,
	faq,
	getStarted,
	hero,
	language,
	pipeline,
	problem,
	stats,
} from "../data/landing";

const pageTitle = "QQL: SQL for Qdrant vector search";
const pageDescription =
	"QQL is to Qdrant what SQL is to Postgres. One declarative language for hybrid search, filtering, mutations, and DDL across Rust, Python, Node.js, WASM, REST, gRPC, and edge.";

// The documentation verifier parses every `verifiedQql` String.raw template
// (see scripts/verify-qql-docs.mjs), so the marker must stay despite none of
// the templates containing backslashes.
const verifiedQqlHero = String.raw`QUERY 'chest pain' FROM medical
USING dense
WHERE department = 'cardio'
SHARD 'hospital-east'
LIMIT 5;`;

const verifiedQqlCompareHybrid = String.raw`QUERY 'distributed consensus' FROM docs
USING HYBRID
  DENSE dense_vec
  SPARSE bm25_vec
  FUSION RRF
WHERE status = 'active'
LIMIT 10;`;

const verifiedQqlCompareTenant = String.raw`QUERY 'annual financial risks' FROM filings
WHERE department = 'finance'
SHARD 'tenant-corp-99'
LIMIT 5;`;

const verifiedQqlCompareFilters = String.raw`QUERY 'industrial robotics' FROM products
WHERE (category = 'hardware' OR category = 'tools')
  AND price <= 1200.0 AND in_stock = true
LIMIT 20;`;

const verifiedQqlHybrid = String.raw`QUERY TEXT 'vector database' FROM docs
  USING HYBRID DENSE dense SPARSE bm25 FUSION RRF
  LIMIT 10;`;

const verifiedQqlFacet = String.raw`FACET room_type FROM stays WHERE price < 150 LIMIT 5 EXACT true;`;

const verifiedQqlFormula = String.raw`QUERY FORMULA MAX(MIN($score * 2.0, 10.0), 0.0) + ACOSH(popularity + 1.0)
  DEFAULTS (score = 0.0, popularity = 0)
FROM papers LIMIT 10;`;

const verifiedQqlGrouped = String.raw`QUERY 'incident'
FROM runbooks
USING dense
GROUP BY service SIZE 3 LOOKUP FROM services
WITH PAYLOAD INCLUDE (title, service)
LIMIT 10;`;

const verifiedQqlRecommend = String.raw`QUERY RECOMMEND POSITIVE (1, 2) NEGATIVE (3) STRATEGY best_score
FROM products
USING dense
LIMIT 10;`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="QQL, Qdrant, vector search, hybrid search, SQL for vector database, Qdrant SQL, Reciprocal Rank Fusion, RRF, multitenancy, filter injection, pyqql, nqql, qql-edge, WASM, Veristamp"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={`${APPS.home.url}/`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.home.url}/`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="QQL" />
    <meta property="og:image" content={`${APPS.home.url}/open-graph/home.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@srimon_12" />
    <meta name="twitter:creator" content="@srimon_12" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${APPS.home.url}/open-graph/home.png`} />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "QQL",
        operatingSystem: "Linux, macOS, Windows, Web",
        applicationCategory: "DeveloperApplication",
        description: pageDescription,
        codeRepository: APPS.github.url,
        license: "https://opensource.org/license/mit",
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        publisher: {
          "@type": "Organization",
          name: SITE.org,
          url: "https://veristamp.in",
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.items.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "QQL",
        url: APPS.home.url,
        description: pageDescription,
        publisher: {
          "@type": "Organization",
          name: SITE.org,
          url: "https://veristamp.in",
        },
      })}
    />
  </head>

  <body class="landing-body">
    <div class="landing-noise" aria-hidden="true"></div>
    <SiteHeader active="home" />

    <main id="main-content">
      <LandingHero
        headline={hero.headline}
        lede={hero.lede}
        eyebrow={hero.eyebrow}
        primaryCta={hero.primaryCta}
        secondaryCta={hero.secondaryCta}
        specimenTitle={hero.specimenTitle}
        specimenMeta={hero.specimenMeta}
        specimenQql={verifiedQqlHero}
      >
        <span class="kw">QUERY</span> <span class="str">'chest pain'</span><br />
        <span class="kw">FROM</span> <span class="id">medical</span><br />
        <span class="kw">USING</span> <span class="id">dense</span><br />
        <span class="kw">WHERE</span> <span class="id">department</span>{" "}
        <span class="op">=</span> <span class="str">'cardio'</span><br />
        <span class="kw">SHARD</span> <span class="str">'hospital-east'</span><br />
        <span class="kw">LIMIT</span> <span class="num">5</span><span class="op">;</span>
      </LandingHero>

      <StatsStrip stats={stats} />

      <ProblemCompare
        heading={problem.heading}
        sub={problem.sub}
        guideHref={problem.guideHref}
        guideLabel={problem.guideLabel}
        hybridQql={verifiedQqlCompareHybrid}
        tenantQql={verifiedQqlCompareTenant}
        filtersQql={verifiedQqlCompareFilters}
      />

      <PipelineSteps
        heading={pipeline.heading}
        sub={pipeline.sub}
        steps={pipeline.steps}
      />

      <LanguageSamples
        heading={language.heading}
        sub={language.sub}
        footHref={language.footHref}
        footLabel={language.footLabel}
        hybridQql={verifiedQqlHybrid}
        facetQql={verifiedQqlFacet}
        formulaQql={verifiedQqlFormula}
        groupedQql={verifiedQqlGrouped}
        recommendQql={verifiedQqlRecommend}
      />

      <InstallGrid
        heading={getStarted.heading}
        sub={getStarted.sub}
        installs={getStarted.installs}
        footHref={getStarted.footHref}
        footLabel={getStarted.footLabel}
      />

      <FaqList heading={faq.heading} items={faq.items} />

      <CtaBand
        heading={cta.heading}
        body={cta.body}
        primaryCta={cta.primaryCta}
        secondaryCta={cta.secondaryCta}
      />
    </main>

    <SiteFooter />

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("landing-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08 },
        );
        document
          .querySelectorAll(".landing-fade-up")
          .forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
