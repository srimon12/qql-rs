---
import "@fontsource/instrument-serif/index.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@qql/ui-docs/chrome.css";
import "@qql/ui-docs/landing.css";
import CapabilityGrid from "../components/landing/CapabilityGrid.astro";
import CtaBand from "../components/landing/CtaBand.astro";
import FaqList from "../components/landing/FaqList.astro";
import InstallGrid from "../components/landing/InstallGrid.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import LanguageSamples from "../components/landing/LanguageSamples.astro";
import LimitsBlock from "../components/landing/LimitsBlock.astro";
import PipelineSteps from "../components/landing/PipelineSteps.astro";
import ProblemCompare from "../components/landing/ProblemCompare.astro";
import StatsBanner from "../components/landing/StatsBanner.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { ANALYTICS, APPS, SITE } from "../config/site";
import {
  architecture,
  cta,
  design,
  faq,
  getStarted,
  hero,
  language,
  limits,
  problem,
  stats,
} from "../data/landing";
import "../styles/global.css";

const pageTitle = "QQL: SQL for Qdrant vector search";
const pageDescription =
  "QQL is to Qdrant what SQL is to Postgres. One declarative language for hybrid search, filtering, mutations, multitenancy, and DDL across Rust, Python, Node.js, WASM, REST, gRPC, and edge.";

// The documentation verifier parses every `verifiedQql` String.raw template.
const verifiedQql = String.raw`CREATE COLLECTION docs (
  dense VECTOR(384, COSINE),
  bm25 SPARSE
);

UPSERT INTO docs VALUES {
  id: 1,
  text: 'QQL provides typed vector retrieval',
  category: 'qql'
} USING HYBRID;

QUERY TEXT 'typed query language' FROM docs
USING HYBRID DENSE dense SPARSE bm25 FUSION RRF
WHERE category = 'qql'
LIMIT 5;`;

const verifiedQqlHybrid = String.raw`WITH
  dense  AS (QUERY TEXT 'ml' USING dense  LIMIT 100),
  sparse AS (QUERY TEXT 'ml' USING bm25   LIMIT 100)
QUERY FUSION RRF FROM docs PREFETCH (dense, sparse) LIMIT 10;`;

const verifiedQqlTenant = String.raw`QUERY TEXT 'supply chain risks' FROM sec10k
WHERE department = 'risk'
SHARD 'honeywell'
LIMIT 10;`;

const terminalCode = `# Install the QQL CLI
curl -fsSL https://raw.githubusercontent.com/srimon12/qql-rs/main/scripts/install.sh | sh

# quickstart.qql
${verifiedQql}`;

const samples = [
  {
    kind: "Hybrid · RRF",
    code: verifiedQqlHybrid,
    href: `/playground/?q=${encodeURIComponent(verifiedQqlHybrid)}`,
  },
  {
    kind: "Multitenant · SHARD",
    code: verifiedQqlTenant,
    href: `/playground/?q=${encodeURIComponent(verifiedQqlTenant)}`,
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="QQL, Qdrant, vector search, hybrid search, SQL, query language, multitenancy, WASM, pyqql, nqql, edge runtime, Veristamp"
    />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="canonical" href={`${APPS.home.url}/`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${APPS.home.url}/`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="QQL" />
    <meta property="og:image" content={`${APPS.home.url}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${APPS.home.url}/og-image.png`} />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        const saved =
          localStorage.getItem("theme") ??
          localStorage.getItem("starlight-theme") ??
          localStorage.getItem("veristamp-theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {
      ANALYTICS.id && (
        <script
          is:inline
          defer
          src={`${ANALYTICS.url}/script.js`}
          data-website-id={ANALYTICS.id}
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "QQL",
        operatingSystem: "Linux, macOS, Windows, Web",
        applicationCategory: "DeveloperApplication",
        description: pageDescription,
        codeRepository: APPS.github.url,
        license: "https://opensource.org/license/mit",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
        publisher: {
          "@type": "Organization",
          name: SITE.org,
          url: "https://veristamp.in",
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.items.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "QQL",
        url: APPS.home.url,
        description: pageDescription,
        publisher: {
          "@type": "Organization",
          name: SITE.org,
          url: "https://veristamp.in",
        },
      })}
    />
  </head>

  <body class="landing-body">
    <div class="landing-noise" aria-hidden="true"></div>
    <div class="landing-tech-grid" aria-hidden="true"></div>
    <div class="landing-glow" aria-hidden="true"></div>

    <SiteHeader active="home" />

    <main id="main-content">
      <LandingHero
        badge={hero.badge}
        headline={hero.headline}
        tagline={hero.tagline}
        lede={hero.lede}
        primaryCta={hero.primaryCta}
        secondaryCta={hero.secondaryCta}
        githubUrl={APPS.github.url}
        hosts={hero.hosts}
        terminalTitle={hero.terminalTitle}
        terminalCode={terminalCode}
      />

      <StatsBanner stats={stats} />

      <ProblemCompare
        heading={problem.heading}
        sub={problem.sub}
        rows={problem.rows}
      />

      <LanguageSamples
        heading={language.heading}
        sub={language.sub}
        footHref={language.footHref}
        footLabel={language.footLabel}
        samples={samples}
      />

      <PipelineSteps
        heading={architecture.heading}
        sub={architecture.sub}
        steps={architecture.steps}
      />

      <CapabilityGrid
        heading={design.heading}
        sub={design.sub}
        capabilities={design.capabilities}
      />

      <LimitsBlock
        statement={limits.statement}
        body={limits.body}
        foot={limits.foot}
      />

      <InstallGrid
        heading={getStarted.heading}
        sub={getStarted.sub}
        installs={getStarted.installs}
        primaryCta={getStarted.primaryCta}
        secondaryCta={getStarted.secondaryCta}
      />

      <FaqList heading={faq.heading} items={faq.items} />

      <CtaBand
        heading={cta.heading}
        body={cta.body}
        primaryCta={cta.primaryCta}
        secondaryCta={cta.secondaryCta}
      />
    </main>

    <SiteFooter />

    <script>
      // Scroll reveals — adds .landing-visible when sections enter view.
      document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("landing-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08 },
        );
        document
          .querySelectorAll(".landing-fade-up")
          .forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
