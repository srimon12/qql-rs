// QQL 1.0 canonical syntax grammar.
//
// This file is the source of truth for lexical and syntactic acceptance. The
// reference parser is a hand-written lexer + recursive-descent AST lowerer in
// qql-core, kept aligned by qql-grammar-gen and the conformance suite. pest is
// not a runtime dependency; qql-core never compiles this grammar. Semantic and
// schema-dependent rules remain in qql-plan and language/v1/spec/semantics.md.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!NEWLINE ~ ANY)* }

script = { SOI ~ (statement ~ (";" ~ statement)* ~ ";"?)? ~ EOI }
single_statement = { SOI ~ statement ~ ";"? ~ EOI }

statement = _{
      query
    | scroll
    | count
    | facet
    | upsert
    | update
    | delete_payload
    | delete_vectors
    | delete
    | clear_payload
    | create_collection
    | alter_collection
    | drop_collection
    | create_index
    | drop_index
    | create_shard_key
    | drop_shard_key
    | show_collections
    | show_collection
    | show_shard_keys
    | show_quotas
    | set_quota
}

// Query

query = {
    (^"WITH" ~ cte ~ ("," ~ cte)*)?
    ~ ^"QUERY" ~ query_expr
    ~ ^"FROM" ~ collection
    ~ query_tail
}

cte = { name ~ ^"AS" ~ "(" ~ cte_query ~ ")" }
cte_query = { ^"QUERY" ~ query_expr ~ (^"FROM" ~ collection)? ~ query_tail }

query_tail = {
    // USING HYBRID expands nearest text → dense+sparse fusion (same as QUERY HYBRID).
    // USING <name> [AS kind] targets a single named vector.
    (^"USING" ~ (hybrid_using | vector_target))?
    ~ (^"PREFETCH" ~ "(" ~ prefetch ~ ("," ~ prefetch)* ~ ")")?
    ~ (^"WHERE" ~ filter)?
    ~ (^"SHARD" ~ (param | string))?
    ~ (^"PARAMS" ~ search_params)?
    ~ (^"SCORE" ~ ^"THRESHOLD" ~ (param | number))?
    ~ group_clause?
    ~ (^"WITH" ~ ^"PAYLOAD" ~ payload_selector)?
    ~ (^"WITH" ~ ^"VECTOR" ~ vector_selector?)?
    ~ (^"LIMIT" ~ (param | non_negative_integer))?
    ~ (^"OFFSET" ~ (param | non_negative_integer))?
}

// Tail-form hybrid: QUERY TEXT '…' FROM c USING HYBRID [DENSE n] [SPARSE n] [FUSION …]
// Canonical AST is QueryExpr::Hybrid (same expand as front-form QUERY HYBRID).
hybrid_using = {
    ^"HYBRID"
    ~ (^"DENSE" ~ vector_name)?
    ~ (^"SPARSE" ~ vector_name)?
    ~ (^"FUSION" ~ fusion_method)?
}

vector_target = { vector_name ~ (^"AS" ~ vector_kind)? }
// MULTI / MULTIVECTOR mark a dense multivector target (ColBERT-style).
// Role is still dense; multi is a shape flag, not a third sparse/dense kind.
vector_kind = { ^"DENSE" | ^"SPARSE" | ^"MULTIVECTOR" | ^"MULTI" }

group_clause = {
    ^"GROUP" ~ ^"BY" ~ field
    ~ (^"SIZE" ~ non_negative_integer)?
    ~ (^"LOOKUP" ~ ^"FROM" ~ collection)?
}

query_expr = _{
      points
    | recommend
    | context
    | discover
    | order_query
    | sample
    | fusion
    | formula
    | feedback
    | mmr
    | hybrid
    // Cross-encoder pair scorer (client-side). Distinct from late-interaction RERANK.
    | cross_rerank
    | rerank
    | nearest
}

points = { ^"POINTS" ~ point_id_list }
nearest = { ^"NEAREST"? ~ query_input }

query_input = _{
      ^"TEXT" ~ (param | string) ~ (^"MODEL" ~ string)?
    // IMAGE: local path or URL → dense embed via host image/CLIP vision model.
    // Same dense role as TEXT; modality is image, not multivector.
    | ^"IMAGE" ~ (param | string) ~ (^"MODEL" ~ string)?
    | ^"VECTOR" ~ (param | vector_value)
    | ^"POINT" ~ point_id
    | param
    | string
}

recommend = {
    ^"RECOMMEND"
    ~ ^"POSITIVE" ~ point_id_list
    ~ (^"NEGATIVE" ~ point_id_list)?
    ~ (^"STRATEGY" ~ recommend_strategy)?
}
recommend_strategy = { ^"average_vector" | ^"best_score" | ^"sum_scores" }

context = { ^"CONTEXT" ~ context_pairs }
discover = { ^"DISCOVER" ~ ^"TARGET" ~ query_input ~ ^"CONTEXT" ~ context_pairs }
context_pairs = { "(" ~ context_pair ~ ("," ~ context_pair)* ~ ")" }
context_pair = { ^"POSITIVE" ~ query_input ~ ^"NEGATIVE" ~ query_input }

order_query = { ^"ORDER" ~ ^"BY" ~ field ~ (^"ASC" | ^"DESC")? }
sample = { ^"SAMPLE" ~ ^"RANDOM" }
fusion = { ^"FUSION" ~ fusion_method }
fusion_method = { ^"RRF" | ^"DBSF" }

formula = { ^"FORMULA" ~ formula_expr ~ (^"DEFAULTS" ~ config_block)? }

feedback = {
    ^"RELEVANCE" ~ ^"FEEDBACK"
    ~ ^"TARGET" ~ query_input
    ~ ^"FEEDBACK" ~ "(" ~ feedback_item ~ ("," ~ feedback_item)* ~ ")"
    ~ ^"STRATEGY" ~ ^"NAIVE"
    ~ "("
    ~ ^"a" ~ "=" ~ number ~ ","
    ~ ^"b" ~ "=" ~ number ~ ","
    ~ ^"c" ~ "=" ~ number
    ~ ")"
}
feedback_item = { "(" ~ query_input ~ "," ~ number ~ ")" }

mmr = {
    ^"MMR" ~ query_input
    ~ ^"DIVERSITY" ~ number
    ~ ^"CANDIDATES" ~ positive_integer
}

hybrid = {
    ^"HYBRID"
    ~ (^"TEXT" ~ string ~ (^"MODEL" ~ string)? | string)
    ~ (^"DENSE" ~ vector_name)?
    ~ (^"SPARSE" ~ vector_name)?
    ~ (^"FUSION" ~ fusion_method)?
}

// Cross-encoder: score (query, doc_text) pairs from PREFETCH hits.
// ON FIELD names the payload key holding document text (default: text).
cross_rerank = {
    ^"CROSS" ~ ^"RERANK"
    ~ (^"TEXT" ~ string | string)
    ~ ^"MODEL" ~ string
    ~ (^"ON" ~ ^"FIELD" ~ field)?
}
// Late-interaction / multivector MaxSim (not cross-encoder).
rerank = { ^"RERANK" ~ rerank_input ~ ^"MODEL" ~ string }
rerank_input = _{
      ^"TEXT" ~ string
    | ^"VECTOR" ~ vector_value
    | ^"POINT" ~ point_id
}

prefetch = {
    (cte_query | cte_name)
    ~ (^"WHERE" ~ filter)?
    ~ (^"SCORE" ~ ^"THRESHOLD" ~ (param | number))?
    ~ (^"LOOKUP" ~ ^"FROM" ~ collection ~ (^"VECTOR" ~ vector_name)?)?
}

// Formula expressions

formula_expr = { formula_sum }
formula_sum = { formula_product ~ (("+" | "-") ~ formula_product)* }
formula_product = {
    formula_prefix
    ~ (
        "*" ~ formula_prefix
        | "/" ~ formula_prefix ~ ("[" ~ ^"DEFAULT" ~ "=" ~ number ~ "]")?
    )*
}
formula_prefix = { "-"? ~ formula_primary }
formula_primary = _{
      param
    | number
    | "(" ~ formula_expr ~ ")"
    | unary_function
    | nary_function
    | ^"POW" ~ "(" ~ formula_expr ~ "," ~ formula_expr ~ ")"
    | geo_distance
    | match_function
    | datetime_function
    | decay_function
    | case_formula
    | formula_variable
}

formula_variable = { identifier }
unary_function = {
    (^"ABS" | ^"SQRT" | ^"LOG" | ^"LN" | ^"EXP" | ^"ACOSH")
    ~ "(" ~ formula_expr ~ ")"
}
// MAX / MIN fold n ≥ 1 operands; at least one operand is required by the
// Qdrant Expression wire format (MaxExpression / MinExpression). The empty
// operand list is rejected by the reference parser (QQL-PARSE-SYNTAX), which
// the grammar cannot express numerically.
nary_function = {
    (^"MAX" | ^"MIN")
    ~ "(" ~ formula_expr ~ ("," ~ formula_expr)* ~ ")"
}
geo_distance = {
    ^"GEO_DISTANCE" ~ "("
    ~ (
        number ~ "," ~ number ~ "," ~ field
        | geo_point ~ ","? ~ field
    )
    ~ ")"
}
match_function = {
    (^"MATCH" | ^"MATCH_ANY")
    ~ "(" ~ field ~ "," ~ (list | value) ~ ")"
}
datetime_function = {
      ^"datetime" ~ "(" ~ string ~ ")"
    | ^"datetime_key" ~ "(" ~ string ~ ")"
}
decay_function = {
    (^"EXP_DECAY" | ^"GAUSS_DECAY" | ^"LIN_DECAY")
    ~ "(" ~ decay_arguments ~ ")"
}
decay_arguments = {
    (decay_argument | formula_expr)
    ~ ("," ~ (decay_argument | formula_expr))*
}
decay_argument = {
    (^"x" | ^"target" | ^"scale" | ^"midpoint" | ^"decay")
    ~ "=" ~ formula_expr
}
case_formula = {
    ^"CASE" ~ ^"WHEN" ~ filter
    ~ ^"THEN" ~ formula_expr
    ~ ^"ELSE" ~ formula_expr
    ~ ^"END"
}

// Filters

filter = { or_filter }
or_filter = { and_filter ~ (^"OR" ~ and_filter)* }
and_filter = { not_filter ~ (^"AND" ~ not_filter)* }
not_filter = { ^"NOT"? ~ filter_primary }

filter_primary = _{
      "(" ~ filter ~ ")"
    | nested_filter
    | has_vector_filter
    | slice_filter
    | predicate
}

slice_filter = { ^"SLICE" ~ "(" ~ non_negative_integer ~ "," ~ non_negative_integer ~ ")" }

nested_filter = { ^"NESTED" ~ "(" ~ string ~ "," ~ filter ~ ")" }
has_vector_filter = { ^"HAS_VECTOR" ~ vector_name }

predicate = { field ~ predicate_tail }
predicate_tail = _{
      comparison_op ~ value
    | ^"BETWEEN" ~ value ~ ^"AND" ~ value
    | ^"NOT"? ~ ^"IN" ~ non_empty_literal_list
    | ^"IS" ~ ^"NOT"? ~ (^"NULL" | ^"EMPTY")
    | ^"MATCH" ~ ^"ANY" ~ non_empty_literal_list
    | ^"MATCH" ~ ^"PHRASE" ~ string
    | ^"MATCH" ~ ^"PREFIX" ~ string
    | ^"MATCH" ~ string
    | ^"VALUES_COUNT" ~ comparison_op ~ non_negative_integer
    | ^"GEO_BBOX" ~ geo_bbox
    | ^"GEO_RADIUS" ~ geo_radius
    | ^"GEO_POLYGON" ~ geo_polygon
}
comparison_op = { "!=" | ">=" | "<=" | "≠" | "≥" | "≤" | "=" | ">" | "<" }
non_empty_literal_list = { "(" ~ scalar ~ ("," ~ scalar)* ~ ")" }

// Point operations

scroll = {
    ^"SCROLL" ~ ^"FROM" ~ collection
    ~ (^"WHERE" ~ filter)?
    ~ (^"AFTER" ~ point_id)?
    ~ (^"SHARD" ~ (param | string))?
    ~ (^"WITH" ~ ^"VECTOR" ~ vector_selector?)?
    ~ ^"LIMIT" ~ (param | non_negative_integer)
}

count = {
    ^"COUNT" ~ ^"FROM" ~ collection
    ~ (^"WHERE" ~ filter)?
    ~ (^"SHARD" ~ (param | string))?
    ~ (^"WITH" ~ count_config)?
}

// COUNT config is exactly `exact = true|false` (strict reference-parser
// contract F-14: unknown keys and non-boolean values are rejected with
// QQL-PARSE-COUNT-CONFIG). `^"exact"` reuses the keyword literal already
// declared by `search_param`, so no new keyword tables are generated. Quoted
// keys are accepted so grammar and reference parser agree on string config
// keys; unknown quoted keys are still rejected at runtime.
count_config = { "(" ~ count_config_entry ~ ("," ~ count_config_entry)* ~ ")" }
count_config_entry = { count_config_key ~ "=" ~ boolean }
count_config_key = { ^"exact" | string }

facet = {
    ^"FACET" ~ (facet_key ~ ^"FROM" ~ collection | ^"FROM" ~ collection ~ (^"KEY")? ~ facet_key)
    ~ facet_clause*
}
facet_clause = _{
      ^"WHERE" ~ filter
    | ^"LIMIT" ~ (param | non_negative_integer)
    | ^"EXACT" ~ boolean?
    | ^"SHARD" ~ (param | string)
    | ^"WITH" ~ facet_config
}
facet_key = { name }
facet_config = { "(" ~ facet_config_entry ~ ("," ~ facet_config_entry)* ~ ")" }
facet_config_entry = { facet_config_key ~ "=" ~ (boolean | integer) }
facet_config_key = { ^"exact" | ^"limit" | string }

upsert = {
    ^"UPSERT" ~ ^"INTO" ~ collection ~ ^"VALUES"
    ~ point_object ~ ("," ~ point_object)*
    ~ embedding_options?
    ~ embed_clause?
    ~ (^"SHARD" ~ (param | string))?
}

embedding_options = {
    ^"USING" ~ single_embedding_spec ~ ("," ~ single_embedding_spec)*
}

single_embedding_spec = _{
    ^"HYBRID"
      ~ (^"DENSE" ~ spec_modifier*)?
      ~ (^"SPARSE" ~ spec_modifier*)?
    // `^"MULTIVECTOR"` must precede `^"MULTI"`: pest literals match prefixes,
    // so `MULTIVECTOR` would otherwise be read as `MULTI` + `VECTOR` modifier.
    | (^"DENSE" | ^"SPARSE" | ^"MULTIVECTOR" | ^"MULTI" | ^"IMAGE") ~ spec_modifier*
    | spec_modifier+
}

spec_modifier = _{
    ^"MODEL" ~ string
    | (^"VECTOR" | ^"INTO") ~ vector_name
    | ^"ON" ~ ^"FIELD"? ~ field
}

embed_clause = { ^"EMBED" ~ embed_directive ~ ("," ~ embed_directive)* }
// Per-field embedding at UPSERT time. `single_embedding_spec` already accepts
// MULTI / MULTIVECTOR / IMAGE beside DENSE / SPARSE; the directive's USING form
// mirrors that set so spec and reference parser agree on all five kinds.
embed_directive = {
    field ~ ^"INTO" ~ vector_name
    ~ (
        ^"USING"
        ~ (
            // `^"MULTIVECTOR"` before `^"MULTI"` (pest literals match prefixes).
            (^"DENSE" | ^"SPARSE" | ^"MULTIVECTOR" | ^"MULTI" | ^"IMAGE")
                ~ (^"MODEL" ~ string)?
            | ^"MODEL" ~ string
        )
    )?
}

delete_vectors = {
    ^"DELETE" ~ ^"VECTOR"
    ~ vector_name ~ ("," ~ vector_name)*
    ~ ^"FROM" ~ collection
    ~ ^"WHERE" ~ filter
    ~ (^"SHARD" ~ (param | string))?
}
delete = {
    ^"DELETE" ~ ^"FROM" ~ collection
    ~ ^"WHERE" ~ filter
    ~ (^"SHARD" ~ (param | string))?
}
clear_payload = {
    ^"CLEAR" ~ ^"PAYLOAD" ~ ^"FROM" ~ collection
    ~ ^"WHERE" ~ filter
    ~ (^"SHARD" ~ (param | string))?
}
delete_payload = {
    ^"DELETE" ~ ^"PAYLOAD"
    ~ field ~ ("," ~ field)*
    ~ ^"FROM" ~ collection
    ~ ^"WHERE" ~ filter
    ~ (^"SHARD" ~ (param | string))?
}

update = {
    ^"UPDATE" ~ collection ~ ^"SET"
    ~ (
        ^"VECTOR" ~ vector_name? ~ "=" ~ (param | vector_value)
        ~ ^"WHERE" ~ ^"id" ~ "=" ~ point_id
        ~ (^"SHARD" ~ (param | string))?
        | ^"PAYLOAD" ~ "=" ~ (param | object)
        ~ ^"WHERE" ~ filter
        ~ (^"SHARD" ~ (param | string))?
    )
}

// DDL

create_collection = {
    ^"CREATE" ~ ^"COLLECTION" ~ collection
    ~ collection_mode?
    ~ ("(" ~ collection_vector ~ ("," ~ collection_vector)* ~ ")")?
    ~ collection_config*
}

collection_mode = {
      ^"USING" ~ (^"DENSE"? ~ ^"MODEL" ~ string | ^"HYBRID")
    | ^"HYBRID"
      ~ (
          ^"RERANK"
          | (^"DENSE" ~ ^"VECTOR" ~ vector_name)?
            ~ (^"SPARSE" ~ ^"VECTOR" ~ vector_name)?
        )?
}

collection_vector = _{ dense_vector_def | sparse_vector_def }
dense_vector_def = {
    vector_name ~ ^"VECTOR"
    ~ "(" ~ positive_integer ~ "," ~ distance ~ ")"
    ~ dense_vector_config*
}
dense_vector_config = {
    ^"WITH"
    ~ (
        ^"HNSW" ~ config_block
        | ^"QUANTIZATION" ~ config_block
        | ^"MULTIVECTOR" ~ config_block
        | ^"VECTOR" ~ config_block
    )
}
sparse_vector_def = {
    vector_name ~ ^"SPARSE"
    ~ (^"WITH" ~ (^"SPARSE" | ^"INDEX") ~ config_block)*
}

collection_config = {
    ^"WITH"
    ~ (
        ^"HNSW" ~ config_block
        | ^"VECTOR" ~ config_block
        | ^"OPTIMIZERS" ~ config_block
        | ^"PARAMS" ~ config_block
        | ^"QUANTIZATION" ~ config_block
    )
}

alter_collection = {
    ^"ALTER" ~ ^"COLLECTION" ~ collection
    ~ collection_config+
}
drop_collection = { ^"DROP" ~ ^"COLLECTION" ~ collection }

create_index = {
    ^"CREATE" ~ ^"INDEX" ~ ^"ON" ~ ^"COLLECTION" ~ collection
    ~ ^"FOR" ~ field
    ~ (^"TYPE" ~ field_type)?
    ~ (^"WITH" ~ config_block)?
}
drop_index = {
    ^"DROP" ~ ^"INDEX" ~ ^"ON" ~ ^"COLLECTION" ~ collection
    ~ ^"FOR" ~ field
}

create_shard_key = {
    ^"CREATE" ~ ^"SHARD" ~ ^"KEY" ~ string
    ~ ^"ON" ~ ^"COLLECTION" ~ collection
    ~ (^"WITH" ~ shard_key_config)?
}

// CREATE SHARD KEY config is exactly `shards_number` / `replication_factor`
// as positive integers (strict reference-parser contract F-15: unknown keys,
// zero, negative, and non-integer values are rejected with
// QQL-PARSE-SHARD-KEY-CONFIG). Keys are matched case-insensitively via
// per-character alternation instead of `^"…"` literals so no new keyword
// tables are generated; quoted keys are accepted for reference-parser
// alignment.
shard_key_config = { "(" ~ shard_key_config_entry ~ ("," ~ shard_key_config_entry)* ~ ")" }
shard_key_config_entry = { shard_key_name ~ "=" ~ shard_key_config_value }
shard_key_name = { shards_number_key | replication_factor_key | string }
// Positive integer *value*: the literal `0` (and any literal whose numeric
// value is 0, e.g. `00`) is rejected, while leading zeros on nonzero values
// (`05`) remain accepted, mirroring the reference parser's value-level `> 0`
// check.
shard_key_config_value = @{
    ("1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9") ~ ASCII_DIGIT*
    | "0" ~ ASCII_DIGIT+
}
shards_number_key = {
    ("s" | "S") ~ ("h" | "H") ~ ("a" | "A") ~ ("r" | "R") ~ ("d" | "D") ~ ("s" | "S")
    ~ "_" ~ ("n" | "N") ~ ("u" | "U") ~ ("m" | "M") ~ ("b" | "B") ~ ("e" | "E") ~ ("r" | "R")
}
replication_factor_key = {
    ("r" | "R") ~ ("e" | "E") ~ ("p" | "P") ~ ("l" | "L") ~ ("i" | "I") ~ ("c" | "C")
    ~ ("a" | "A") ~ ("t" | "T") ~ ("i" | "I") ~ ("o" | "O") ~ ("n" | "N")
    ~ "_" ~ ("f" | "F") ~ ("a" | "A") ~ ("c" | "C") ~ ("t" | "T") ~ ("o" | "O") ~ ("r" | "R")
}
drop_shard_key = {
    ^"DROP" ~ ^"SHARD" ~ ^"KEY" ~ string
    ~ ^"ON" ~ ^"COLLECTION" ~ collection
}

show_collections = { ^"SHOW" ~ ^"COLLECTIONS" }
show_collection = { ^"SHOW" ~ ^"COLLECTION" ~ collection }
show_shard_keys = {
    ^"SHOW" ~ ^"SHARD" ~ ^"KEYS"
    ~ ^"ON" ~ ^"COLLECTION" ~ collection
}
show_quotas = { ^"SHOW" ~ ^"QUOTAS" }
set_quota = {
    ^"SET" ~ ^"QUOTA" ~ config_block
    ~ (^"WAIT" ~ boolean)?
}

// Selectors and search parameters

payload_selector = _{
      boolean
    | ^"INCLUDE" ~ name_list
    | ^"EXCLUDE" ~ name_list
}
vector_selector = _{ boolean | name_list }
name_list = { "(" ~ name ~ ("," ~ name)* ~ ")" }

search_params = { "(" ~ search_param ~ ("," ~ search_param)* ~ ")" }
// Body SearchParams (hnsw_ef, acorn, …) vs request-level opts (timeout, consistency).
// OpenAPI: timeout/consistency are URL query params on /points/query (not body fields).
// Proto QueryPoints: optional timeout + read_consistency.
search_param = _{
      ^"hnsw_ef" ~ "=" ~ positive_integer
    | ^"exact" ~ "=" ~ boolean
    | ^"acorn" ~ "=" ~ boolean
    | ^"max_selectivity" ~ "=" ~ positive_number
    | ^"indexed_only" ~ "=" ~ boolean
    | ^"rrf_k" ~ "=" ~ positive_integer
    | ^"rrf_weights" ~ "=" ~ number_list
    | ^"quantization" ~ "=" ~ quantization_search
    // Per-query IDF corpus for sparse vectors: global scope or a QQL filter.
    | ^"idf" ~ "=" ~ idf_param
    // Request-level (REST query string / gRPC fields) — seconds, min 1
    | ^"timeout" ~ "=" ~ positive_integer
    // ReadConsistency: non-negative integer factor N, or majority | quorum | all
    | ^"consistency" ~ "=" ~ (non_negative_integer | ^"majority" | ^"quorum" | ^"all")
}
idf_param = _{
      string
    | ^"global"
    | ^"WHERE" ~ filter
}
quantization_search = {
    "{"
    ~ (^"ignore" ~ ":" ~ boolean ~ ","?)?
    ~ (^"rescore" ~ ":" ~ boolean ~ ","?)?
    ~ (^"oversampling" ~ ":" ~ positive_number)?
    ~ "}"
}

// Values and vector literals

point_object = { "{" ~ point_entry ~ ("," ~ point_entry)* ~ "}" }
point_entry = { object_key ~ ":" ~ value }

vector_value = _{ sparse_vector | multidense_vector | dense_vector }
dense_vector = { "[" ~ number ~ ("," ~ number)* ~ "]" }
multidense_vector = { "[" ~ dense_vector ~ ("," ~ dense_vector)* ~ "]" }
sparse_vector = {
    "{"
    ~ ^"indices" ~ ":" ~ integer_list ~ ","
    ~ ^"values" ~ ":" ~ number_list
    ~ "}"
}

param = { ":" ~ identifier | "?" }

value = _{ scalar | object | list }
scalar = _{ param | string | float | integer | boolean | null | identifier }
object = { "{" ~ (object_entry ~ ("," ~ object_entry)*)? ~ "}" }
object_entry = { object_key ~ ":" ~ value }
object_key = { name }
list = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

config_block = { "(" ~ config_entry ~ ("," ~ config_entry)* ~ ")" }
config_entry = { object_key ~ "=" ~ value }

integer_list = { "[" ~ integer ~ ("," ~ integer)* ~ "]" }
number_list = { "[" ~ number ~ ("," ~ number)* ~ "]" }

geo_point = {
    "{" ~ ^"lat" ~ ":" ~ number ~ ","
    ~ ^"lon" ~ ":" ~ number ~ "}"
}
geo_bbox = {
    "{" ~ ^"top_left" ~ ":" ~ geo_point ~ ","
    ~ ^"bottom_right" ~ ":" ~ geo_point ~ "}"
}
geo_radius = {
    "{" ~ ^"center" ~ ":" ~ geo_point ~ ","
    ~ ^"radius" ~ ":" ~ positive_number ~ "}"
}
geo_polygon = {
    "{" ~ ^"exterior" ~ ":" ~ geo_ring
    ~ ("," ~ ^"interiors" ~ ":" ~ "[" ~ geo_ring ~ ("," ~ geo_ring)* ~ "]")?
    ~ "}"
}
geo_ring = {
    "[" ~ geo_point ~ "," ~ geo_point ~ "," ~ geo_point
    ~ ("," ~ geo_point)* ~ "]"
}

// Lexical terminals

name = _{ identifier | string }
collection = { name }
vector_name = { name }
cte_name = { name }
field = { identifier | string }
point_id = _{ param | unsigned_integer | string }
point_id_list = { "(" ~ point_id ~ ("," ~ point_id)* ~ ")" }

identifier = @{
    identifier_start
    ~ identifier_char*
    ~ (("." | "[].") ~ identifier_segment)*
}
identifier_segment = @{ identifier_letter ~ identifier_char* }
identifier_start = _{ identifier_letter | "$" }
identifier_letter = _{ ASCII_ALPHA | "_" }
identifier_char = _{ ASCII_ALPHANUMERIC | "_" | "$" }

number = _{ float | integer }
positive_number = { number }
integer = @{ "-"? ~ ASCII_DIGIT+ }
unsigned_integer = @{ ASCII_DIGIT+ }
positive_integer = { unsigned_integer }
non_negative_integer = { unsigned_integer }
float = @{
    "-"? ~ ASCII_DIGIT+
    ~ (
        "." ~ ASCII_DIGIT+ ~ exponent?
        | exponent
    )
}
exponent = @{ (^"e" | ^"E") ~ ("+" | "-")? ~ ASCII_DIGIT+ }

string = _{ triple_quoted_string | raw_string | backtick_string | single_quoted_string | double_quoted_string }
triple_quoted_string = @{
    ("'''" ~ (!"'''" ~ ANY)* ~ "'''")
    | ("\"\"\"" ~ (!"\"\"\"" ~ ANY)* ~ "\"\"\"")
}
raw_string = @{
    ("r'" ~ (!"'" ~ ANY)* ~ "'")
    | ("r\"" ~ (!"\"" ~ ANY)* ~ "\"")
}
backtick_string = @{
    "`" ~ (!"`" ~ ANY)* ~ "`"
}
single_quoted_string = @{
    "'"
    ~ (
        "''"
        | "\\" ~ ("\\" | "'" | "\"" | "n" | "r" | "t" | "$")
        | !("'" | "\\") ~ ANY
    )*
    ~ "'"
}
double_quoted_string = @{
    "\""
    ~ (
        "\\" ~ ("\\" | "'" | "\"" | "n" | "r" | "t" | "$")
        | !("\"" | "\\") ~ ANY
    )*
    ~ "\""
}

boolean = { ^"true" | ^"false" }
null = { ^"null" }
distance = { ^"COSINE" | ^"DOT" | ^"EUCLID" | ^"MANHATTAN" }
field_type = {
      ^"keyword"
    | ^"integer"
    | ^"float"
    | ^"geo"
    | ^"text"
    | ^"bool"
    | ^"datetime"
    | ^"uuid"
}
