-- syntax-errors.qql — malformed or legacy QQL programs

-- @case top-level-query-missing-from
-- @error QQL-VALIDATION-FROM
QUERY 'search' LIMIT 10;

-- @case bare-query-number
-- @error QQL-PARSE-QUERY-INPUT
QUERY 42 FROM docs LIMIT 10;

-- @case clause-out-of-order
-- @error QQL-PARSE-CLAUSE-ORDER
QUERY 'search' FROM docs WHERE status = 'active' PREFETCH (c) LIMIT 10;

-- @case invalid-vector-kind
-- @error QQL-PARSE-VECTOR-KIND
QUERY 'search' FROM docs USING lexical_v2 AS HYBRID LIMIT 10;

-- @case empty-statement
-- @error QQL-PARSE-EMPTY-STATEMENT
;

-- @case unmatched-parenthesis
-- @error QQL-PARSE-EXPECTED
QUERY 'search' FROM docs WHERE (status = 'active' LIMIT 10;

-- @case unterminated-string
-- @error QQL-LEX-STRING
QUERY 'unterminated FROM docs LIMIT 10;

-- @case number-malformed-exponent
-- @error QQL-LEX-NUMBER
UPSERT INTO docs VALUES {id: 1, v: 1e};

-- @case number-trailing-dot
-- @error QQL-LEX-NUMBER
COUNT FROM docs WHERE score >= 1.;

-- @case number-minus-before-dot
-- @error QQL-LEX-NUMBER
COUNT FROM docs WHERE score >= -.5;

-- @case legacy-select
-- @error QQL-PARSE-STATEMENT
SELECT * FROM docs WHERE id = 42;

-- @case legacy-insert
-- @error QQL-PARSE-STATEMENT
INSERT INTO docs VALUES {id: 1};

-- @case legacy-boost
BOOST ($score * 2);

-- @case legacy-collection-vectors-prefix
CREATE COLLECTION docs VECTORS (dense VECTOR (4, COSINE));

-- @case legacy-implicit-vector-name
CREATE COLLECTION docs (VECTOR (4, COSINE));

-- @case legacy-omitted-vector-keyword
CREATE COLLECTION docs (dense (4, COSINE));

-- @case legacy-vector-config-plural
CREATE COLLECTION docs (
  dense VECTOR (4, COSINE) WITH VECTORS (on_disk = true)
);

-- @case legacy-quantize
ALTER COLLECTION docs WITH QUANTIZE (type = 'scalar');

-- @case legacy-shard-without-key
CREATE SHARD 'tenant' ON COLLECTION docs;

-- @case legacy-short-rrf-k
QUERY TEXT 'x' FROM docs PARAMS (k = 30);

-- @case legacy-short-rrf-weights
QUERY TEXT 'x' FROM docs PARAMS (weights = [1.0]);

-- @case legacy-quoted-index-type
-- @error QQL-PARSE-INDEX-TYPE
CREATE INDEX ON COLLECTION docs FOR title TYPE 'text';

-- @case count-reversed-clauses
-- @error QQL-PARSE-CLAUSE-ORDER
COUNT FROM docs WITH (exact = true) SHARD 'x';

-- @case count-repeated-shard
-- @error QQL-PARSE-CLAUSE-ORDER
COUNT FROM docs SHARD 'a' SHARD 'b';

-- @case index-unknown-field-type
-- @error QQL-PARSE-INDEX-TYPE
CREATE INDEX ON COLLECTION docs FOR title TYPE banana;

-- @case feedback-reordered-params
-- @error QQL-PARSE-FEEDBACK-STRATEGY
QUERY RELEVANCE FEEDBACK TARGET TEXT 'search'
FEEDBACK ((TEXT 'relevant', 1.5))
STRATEGY NAIVE (a = 1.0, c = 0.2, b = 0.5)
FROM docs LIMIT 10;

-- @case feedback-extra-params
-- @error QQL-PARSE-FEEDBACK-STRATEGY
QUERY RELEVANCE FEEDBACK TARGET TEXT 'search'
FEEDBACK ((TEXT 'relevant', 1.5))
STRATEGY NAIVE (a = 1.0, b = 0.5, c = 0.2, d = 0.1)
FROM docs LIMIT 10;

-- @case rerank-bare-string-input
-- @error QQL-PARSE-RERANK
QUERY RERANK 'vector database' MODEL 'reranker-v1'
FROM docs
USING colbert AS DENSE
PREFETCH (candidates)
LIMIT 10;

-- @case formula-max-without-operands
-- @error QQL-PARSE-SYNTAX
QUERY FORMULA MAX() DEFAULTS (score = 0.0) FROM docs LIMIT 10;

-- @case formula-min-without-operands
-- @error QQL-PARSE-SYNTAX
QUERY FORMULA MIN() DEFAULTS (score = 0.0) FROM docs LIMIT 10;

-- @case create-collection-vector-size-above-maximum
-- @error QQL-PARSE-VECTOR-SIZE
CREATE COLLECTION docs (oversized VECTOR(65537, COSINE));

-- @case number-exponent-overflow-value
-- @error QQL-PARSE-FLOAT
UPSERT INTO docs VALUES {id: 1, v: 1e999};

-- @case number-exponent-overflow-formula
-- @error QQL-PARSE-NUMBER
QUERY FORMULA 1e999 FROM docs LIMIT 5;

-- @case limit-beyond-u64-range
-- @error QQL-PARSE-POSITIVE-INTEGER
QUERY VECTOR [0.1] FROM docs USING dense LIMIT 18446744073709551616;
