-- embedding-modifiers.qql — Additive minor features: ON FIELD, INTO, and multi-spec embedding options

-- Explicit payload text field and destination vector targeting
UPSERT INTO docs VALUES {id: 1, text: 'hello', title: 'world'} USING DENSE MODEL 'nomic' ON FIELD title INTO title_vec;

-- Multi-spec comma-separated embedding options
UPSERT INTO docs VALUES {id: 1, text: 'hello', title: 'world'} USING DENSE MODEL 'm1' ON FIELD text INTO dense, DENSE MODEL 'm2' ON FIELD title INTO title_vec;

-- Explicit field targeting for sparse model
UPSERT INTO docs VALUES {id: 1, text: 'hello', body: 'body text'} USING SPARSE MODEL 'bm25' ON FIELD body INTO sparse_vec;
