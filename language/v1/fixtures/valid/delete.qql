-- delete.qql — DELETE statements

-- Delete by ID filter
DELETE FROM docs WHERE id = 42;

-- Delete by string ID
DELETE FROM docs WHERE id = 'uuid-here';

-- Delete by field filter
DELETE FROM docs WHERE status = 'archived';

-- Delete with complex filter
DELETE FROM docs WHERE status = 'deleted' AND created_year < 2020;

-- Delete with shard routing
DELETE FROM sec10k WHERE tenant_id = 'honeywell' SHARD 'honeywell';

-- Delete by ID IN filter
DELETE FROM docs WHERE id IN (1, 2, 3);

