-- create-collection-memory.qql — v1.19 memory strategy + datatypes
-- Tests: memory placement, turbo4 datatype, payload memory

-- Dense vector with turbo4 datatype and cached memory placement
CREATE COLLECTION docs (
  dense VECTOR(384, COSINE) WITH VECTOR (memory = 'cached', datatype = 'turbo4')
) WITH HNSW (memory = 'cold') WITH PARAMS (payload_memory = 'cold');

-- Sparse index with memory placement
CREATE COLLECTION docs2 (
  sparse SPARSE WITH SPARSE (modifier = 'idf', memory = 'cached')
);

-- Quantization with memory placement
CREATE COLLECTION docs3 (
  dense VECTOR(128, DOT) WITH QUANTIZATION (type = 'scalar', memory = 'pinned')
);
