-- query-mmr.qql — Maximal Marginal Relevance

-- Basic MMR
QUERY MMR TEXT 'vector database' DIVERSITY 0.7 CANDIDATES 100
FROM docs
USING dense
LIMIT 10;

-- MMR with vector input
QUERY MMR VECTOR [0.1, 0.2, 0.3] DIVERSITY 0.5 CANDIDATES 50 FROM docs LIMIT 10;

-- MMR with point input
QUERY MMR POINT 42 DIVERSITY 0.8 CANDIDATES 200 FROM docs LIMIT 10;

-- MMR with filter
QUERY MMR TEXT 'search' DIVERSITY 0.6 CANDIDATES 100
FROM docs
WHERE category = 'tech'
LIMIT 10;

-- MMR with prefetch
WITH
  candidates AS (QUERY 'search' USING dense LIMIT 200)
QUERY MMR TEXT 'search' DIVERSITY 0.6 CANDIDATES 100
FROM docs
PREFETCH (candidates)
LIMIT 10;

